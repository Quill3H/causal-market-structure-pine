# Off-TradingView Standalone Trading Engine Configuration
# API keys are OPTIONAL: public-market sync, backtesting, and PAPER mode work without any keys.
# Copy this file to .env (never commit .env!) and fill in personal keys only when ready.

EXCHANGE=OKX
SYMBOLS=BTCUSDT.P
TIMEFRAMES=1h,15m

# Hard Safety Defaults (DO NOT change unless you understand real-money risk)
EXECUTION_MODE=PAPER
DRY_RUN=true
MAX_LEVERAGE_CAP=3.0
MAX_ORDER_USDT=500

# Local-only HTTP Command Center (must remain loopback)
HOST=127.0.0.1
PORT=4180

# Required explicit confirmation token to arm LIVE_ARMED or send real orders
LIVE_CONFIRM_TOKEN=

# Local SQLite WAL persistence path (relative to repo root or inside data/)
SQLITE_PATH=data/standalone.sqlite

# Optional Personal OKX V5 API Keys (OKX_SIMULATED=1 uses OKX Demo Trading)
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
OKX_SIMULATED=1

# Optional Personal Binance USD-M Futures API Keys (BINANCE_TESTNET=1 uses Futures Testnet)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=1
