type store
    line    [] ln
    label   [] lb
    box     [] bx
    linefill[] lf

type structure
    int    zn
    float  zz
    float  bos
    float  choch
    int    loc
    int    temp
    int    trend
    int    start
    float  main
    int    xloc
    bool   upsweep
    bool   dnsweep
    string txt = na

type drawms
    int    x1
    int    x2
    float  y
    string txt
    color  css
    string style

type ob
    bool  bull
    float top
    float btm
    float avg
    int   loc
    color css
    float vol
    float sourceRvol = na
    float chochSourceRvol = na
    bool  signaled = false
    bool  isbb = false
    int   bbloc

type FVG
    float top     = na
    float btm     = na
    int   loc     = bar_index
    bool  isbb    = false
    int   bbloc   = na
    bool  israid  = false
    float raidy   = na
    int   raidloc = na
    int   raidx2  = na
    bool  active  = false
    color raidcs  = na

type liqZone
    float price
    float weight
    int   side
    int   born
    int   updated
    bool  touched = false
    int   touchedBar = na

type paperVisual
    int   side
    int   xStart
    int   xEnd
    float entryPrice
    float stopPrice
    float initialStop
    float targetPrice
    bool  beArmed
    int   outReason

var store bin = store.new(
     array.new<line>(),
     array.new<label>(),
     array.new<box>(),
     array.new<linefill>()
     )

if barstate.islast
    for obj in bin.ln
        obj.delete()
    for obj in bin.lb
        obj.delete()
    for obj in bin.bx
        obj.delete()
    for obj in bin.lf
        obj.delete()
    bin.ln.clear()
    bin.lb.clear()
    bin.bx.clear()
    bin.lf.clear()

// ============================================================================
// TOP-LEVEL UNCONDITIONAL INDICATORS & HTF REQUESTS
// ============================================================================
float chartSeconds = timeframe.in_seconds()
bool is15mProfile = chartSeconds <= 900
bool useV3Mode = signalMode == "SMC High-WinRate [v3.0]"

float atr200 = ta.atr(200)
float atr = atr200 / (5 / len)
float phRaw = ta.pivothigh(high, mslen, mslen)
float plRaw = ta.pivotlow(low, mslen, mslen)
float signalVolumeBase = ta.sma(volume, signalVolLength)[1]
float chochVolumeBase = ta.sma(volume, 20)[1]

float qualityAtr = ta.atr(14)
float qualityAtrBaseline = ta.sma(qualityAtr, 100)[1]
float qualityVolumeBaseline = ta.sma(volume, 20)[1]
float ltfEma20 = ta.ema(close, 20)
float ltfEma50 = ta.ema(close, 50)
float ltfPrevHigh20 = ta.highest(high, 20)[1]
float ltfPrevLow20 = ta.lowest(low, 20)[1]

string v3HtfTf = chartSeconds <= 900 ? "60" : chartSeconds < 14400 ? "240" : timeframe.period
string v3D1Tf = chartSeconds < 86400 ? "1D" : timeframe.period

[rawHtfO, rawHtfH, rawHtfL, rawHtfC, rawHtfEma50, rawHtfAtr14, rawHtfRsi14, rawHtfPrevH10, rawHtfPrevL10, rawHtfV3CloseTime] = request.security(
     syminfo.tickerid, v3HtfTf,
     [open, high, low, close, ta.ema(close, 50), ta.atr(14), ta.rsi(close, 14), ta.highest(high, 10)[1], ta.lowest(low, 10)[1], time_close],
     gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

[rawD1High, rawD1Low, rawD1CloseTime] = request.security(
     syminfo.tickerid, v3D1Tf,
     [high, low, time_close],
     gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

string autoHTF = chartSeconds <= 300 ? "15" : chartSeconds <= 900 ? "60" : chartSeconds <= 3600 ? "240" : chartSeconds <= 14400 ? "1D" : chartSeconds <= 86400 ? "1W" : "1M"
string trendHTF = qualityHTF == "" ? autoHTF : qualityHTF
bool validHTF = timeframe.in_seconds(trendHTF) > chartSeconds
[rawHtfClose, rawHtfAverage, rawHtfCloseTime] = request.security(
     syminfo.tickerid, trendHTF,
     [close, ta.ema(close, 50), time_close],
     gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

string heatmapAutoOiSymbol = heatmapOiExchange + ":" + syminfo.basecurrency + "USDT.P_OI"
string heatmapOiSymbol = str.length(heatmapOiOverride) > 0 ? heatmapOiOverride : heatmapAutoOiSymbol
float heatmapOi = request.security(heatmapOiSymbol, timeframe.period, close, gaps = barmerge.gaps_on, lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true, calc_bars_count = 5000)
float heatmapOiDelta = ta.change(heatmapOi)
float heatmapOiAbsDelta = math.abs(heatmapOiDelta)
float heatmapOiMean = ta.sma(heatmapOiAbsDelta, heatmapLookback)
float heatmapOiDev = ta.stdev(heatmapOiAbsDelta, heatmapLookback)
float heatmapVolMean = ta.sma(volume, heatmapLookback)
float heatmapVolDev = ta.stdev(volume, heatmapLookback)
float heatmapAtr = ta.atr(50)

bool v3HtfBoundary = timeframe.change(v3HtfTf)
bool d1Boundary = timeframe.change(v3D1Tf)
bool htfBoundary = timeframe.change(trendHTF)

// ============================================================================
// HELPER FUNCTIONS (identical to TOOL.pine)
// ============================================================================
method txSz(string s) =>
    out = switch s
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        "Huge"   => size.huge
        "Auto"   => size.auto
    out

method lstyle(string style) =>
    out = switch style
        '⎯⎯⎯⎯'  => line.style_solid
        '----'  => line.style_dashed
        '····'  => line.style_dotted

historyOffset(int loc) =>
    math.min(math.max(bar_index - nz(loc, bar_index), 0), math.min(bar_index, HISTORY_LIMIT))

method IDMIDX(bool use_max, int loc) =>
    int idx = 0
    float extreme = na
    for i = 0 to historyOffset(loc)
        float value = use_max ? high[i] : low[i]
        if not na(value) and (na(extreme) or (use_max ? value >= extreme : value <= extreme))
            extreme := value
            idx := i
    idx

method find(structure ms, bool use_max, bool sweep, bool useob) =>
    int span = historyOffset(sweep ? ms.xloc : ms.loc)
    int last = span > 1 ? span - 1 : span
    int idx = 0
    float extreme = na
    for i = 0 to last
        float value = use_max ? high[i] : low[i]
        if not na(value) and (na(extreme) or (use_max ? value >= extreme : value <= extreme))
            extreme := value
            idx := i
    if useob and idx < math.min(bar_index, HISTORY_LIMIT)
        if use_max ? high[idx + 1] > high[idx] : low[idx + 1] < low[idx]
            idx += 1
    idx

relativeVolume(float measured, float baseline) =>
    not na(measured) and not na(baseline) and baseline > 0 ? measured / baseline : na

heatmapAddZone(liqZone[] zones, float level, float weight, int side, float binSize) =>
    if not na(level) and not na(weight) and weight > 0 and binSize > 0
        float snapped = math.round(level / binSize) * binSize
        int match = -1
        if zones.size() > 0
            for i = 0 to zones.size() - 1
                zone = zones.get(i)
                if not zone.touched and zone.side == side and math.abs(zone.price - snapped) <= binSize * 0.5
                    match := i
                    break
        if match >= 0
            zone = zones.get(match)
            float combined = zone.weight + weight
            zone.price := (zone.price * zone.weight + snapped * weight) / combined
            zone.weight := combined
            zone.updated := bar_index
        else
            zones.unshift(liqZone.new(price = snapped, weight = weight, side = side, born = bar_index, updated = bar_index))
    true

heatmapNearest(liqZone[] zones, int side, float currentPrice) =>
    int found = -1
    float distance = na
    float weight = na
    if zones.size() > 0
        for i = 0 to zones.size() - 1
            zone = zones.get(i)
            bool locatedCorrectly = side == -1 ? zone.price < currentPrice : zone.price > currentPrice
            if not zone.touched and zone.side == side and locatedCorrectly
                float candidate = math.abs(zone.price - currentPrice)
                if na(distance) or candidate < distance
                    found := i
                    distance := candidate
                    weight := zone.weight
    [found, distance, weight]

chochSourceSignal(bool confirmed, bool event, float sourceRvol, float minimum) =>
    confirmed and event and not na(sourceRvol) and sourceRvol >= minimum

heatmapSignalGate(bool enabled, bool ready, float targetPressure, float oppositePressure, float minimumRatio) =>
    not enabled or (ready and not na(targetPressure) and not na(oppositePressure) and targetPressure > 0 and oppositePressure > 0 and targetPressure >= oppositePressure * minimumRatio)

lossReversalDecision(int samples, int losses, int minimumSamples, float minimumLossPct) =>
    samples > 0 and samples >= minimumSamples and losses * 100 >= minimumLossPct * samples

recordSettledOutcome(int[] history, bool lost, int maximum) =>
    history.push(lost ? 1 : 0)
    if history.size() > maximum
        history.shift()
    true

minimumGate(bool enabled, float value, float minimum) =>
    not enabled or (not na(value) and value >= minimum)

directionGate(bool enabled, int direction, int htfDirection) =>
    not enabled or (htfDirection != 0 and direction == htfDirection)

cooldownGate(bool enabled, int lastEmittedBar, int currentBar, int spacing) =>
    not enabled or na(lastEmittedBar) or currentBar - lastEmittedBar >= spacing

closedHtfSnapshotValid(bool higher, int sourceCloseTime, int chartCloseTime, int boundaryTime, float price, float average) =>
    higher and not na(sourceCloseTime) and sourceCloseTime == boundaryTime and chartCloseTime == boundaryTime and not na(price) and not na(average)

adverseFill(float price, int side, bool isEntry, float slipPct) =>
    price * (1.0 + (isEntry ? side : -side) * slipPct / 100.0)

resolvePaperLevels(int side, float refEntry, float atrVal, float stopAtrVal, float minStopPctVal, float rrVal) =>
    float baseDist = atrVal * stopAtrVal
    float minDist = minStopPctVal > 0 ? refEntry * minStopPctVal / 100.0 : 0.0
    float dist = math.max(baseDist, minDist)
    float stop = refEntry - side * dist
    float target = refEntry + side * dist * rrVal
    bool ok = math.abs(side) == 1 and not na(refEntry) and refEntry > 0 and not na(atrVal) and atrVal > 0 and stopAtrVal > 0 and rrVal >= 0.75 and not na(dist) and dist > 0 and stop > 0 and target > 0 and side * (refEntry - stop) > 0 and side * (target - refEntry) > 0
    [ok, stop, target, dist]

paperExitConservative(int side, string entryMode, bool isEntryBar, bool filledAtOpen, bool beArmed, float o, float h, float l, float c, float stop, float target, int age, int maximum) =>
    float price = na
    int reason = 0
    bool bull = side == 1
    if math.abs(side) == 1
        bool canUseGapAndHighLowTp = entryMode == "MARKET_NEXT_OPEN" or not isEntryBar or filledAtOpen
        bool gapStop = bull ? o <= stop : o >= stop
        bool gapTarget = canUseGapAndHighLowTp and (bull ? o >= target : o <= target)
        bool hitStop = bull ? l <= stop : h >= stop
        bool hitTarget = canUseGapAndHighLowTp ? (bull ? h >= target : l <= target) : (bull ? c >= target : c <= target)
        int stopCode = beArmed ? 4 : 1
        if gapStop
            price := o
            reason := stopCode
        else if gapTarget
            price := target
            reason := 2
        else if hitStop
            price := stop
            reason := stopCode
        else if hitTarget
            price := target
            reason := 2
        else if age >= maximum
            price := c
            reason := 3
    [price, reason]

recordShadowOutcome(int[] slHist, float[] netHist, bool isSl, float netPct, int maxLen) =>
    slHist.push(isSl ? 1 : 0)
    netHist.push(netPct)
    if slHist.size() > maxLen
        slHist.shift()
    if netHist.size() > maxLen
        netHist.shift()
    true

adaptivePolarityFlip(int[] slHist, float[] netHist, int winLen, int slThresh) =>
    int n = slHist.size()
    int minLen = math.min(slThresh, winLen)
    bool flip = false
    if n >= minLen and n > 0
        int slCount = slHist.sum()
        float netSum = netHist.sum()
        flip := slCount >= slThresh and netSum < 0.0
    flip

structureEventDirection(string eventType, int direction) =>
    eventType == "choch" and math.abs(direction) == 1 ? direction : 0

method fnOB(ob[] block, bool bull, float cords, int idx, float sourceRvol, float chochSourceRvol) =>
    float top = bull ? cords : high[idx]
    float bottom = bull ? low[idx] : cords
    if not na(top) and not na(bottom) and top > bottom
        block.unshift(ob.new(bull = bull, top = top, btm = bottom, avg = math.avg(top, bottom), loc = time, css = bull ? obupcs : obdncs, vol = volume[idx], sourceRvol = sourceRvol, chochSourceRvol = chochSourceRvol))
        if block.size() > MAX_ZONES
            block.pop()

zonesOverlap(float topA, float bottomA, float topB, float bottomB) =>
    math.min(topA, topB) > math.max(bottomA, bottomB)

recentEvent(int eventBar, int currentBar, int lookback) =>
    not na(eventBar) and currentBar >= eventBar and currentBar - eventBar <= lookback

zoneRejection(ob zone, int direction, int candleTime, float candleHigh, float candleLow, float candleClose) =>
    bool bull = direction == 1
    zone.bull == bull and not zone.isbb and not zone.signaled and zone.loc < candleTime and candleHigh >= zone.btm and candleLow <= zone.top and (bull ? candleClose > zone.top : candleClose < zone.btm)

gapConfirmation(FVG[] gaps, ob zone, int direction, int candleTime, float candleHigh, float candleLow, float candleClose) =>
    bool confirmed = false
    for gap in gaps
        if not gap.isbb and gap.loc < candleTime and zonesOverlap(zone.top, zone.btm, gap.top, gap.btm)
            bool touched = candleLow <= math.min(zone.top, gap.top) and candleHigh >= math.max(zone.btm, gap.btm)
            bool rejected = direction == 1 ? candleClose > math.max(zone.top, gap.top) : candleClose < math.min(zone.btm, gap.btm)
            if touched and rejected
                confirmed := true
                break
    confirmed

signalEvidence(int direction, int mappingTrend, bool gapOK, bool sweepOK, float confirmationRvol, float sourceRvol) =>
    int enabled = (signalUseMapping ? 1 : 0) + (signalUseFVG ? 1 : 0) + (signalUseSweep ? 1 : 0) + (signalUseVolume ? 1 : 0) + (signalUseSourceVolume ? 1 : 0)
    int score = (signalUseMapping and mappingTrend == direction ? 1 : 0) + (signalUseFVG and gapOK ? 1 : 0) + (signalUseSweep and sweepOK ? 1 : 0) + (signalUseVolume and not na(confirmationRvol) and confirmationRvol >= signalVolumeMin ? 1 : 0) + (signalUseSourceVolume and not na(sourceRvol) and sourceRvol >= signalSourceMin ? 1 : 0)
    bool available = (not signalUseVolume or not na(confirmationRvol)) and (not signalUseSourceVolume or not na(sourceRvol))
    [score, enabled, available]

evidenceDecision(string mode, int minimum, int score, int enabled, bool available) =>
    available and score >= (mode == "Strict" ? enabled : math.min(minimum, enabled))

signalAgreement(int direction, int structureTrend, int mappingTrend, bool gapOK, bool sweepOK, float confirmationRvol, float sourceRvol) =>
    [score, enabled, available] = signalEvidence(direction, mappingTrend, gapOK, sweepOK, confirmationRvol, sourceRvol)
    structureTrend == direction and evidenceDecision(signalMode, signalMinEvidence, score, enabled, available)

resolveSignals(bool confirmed, int bullIndex, int bearIndex) =>
    [confirmed and bullIndex >= 0 and bearIndex < 0, confirmed and bearIndex >= 0 and bullIndex < 0]

signalCandidate(ob[] zones, FVG[] gaps, int direction, int structureTrend, int mappingTrend, bool sweepOK, float confirmationRvol) =>
    int found = -1
    if barstate.isconfirmed and structureTrend == direction and zones.size() > 0
        for i = 0 to zones.size() - 1
            zone = zones.get(i)
            if zoneRejection(zone, direction, time, high, low, close)
                bool gapOK = not signalUseFVG or gapConfirmation(gaps, zone, direction, time, high, low, close)
                if signalAgreement(direction, structureTrend, mappingTrend, gapOK, sweepOK, confirmationRvol, zone.sourceRvol)
                    found := i
                    break
    found

preferFirst(int firstTime, int secondTime, string policy) =>
    policy == "Recent" ? firstTime >= secondTime : firstTime <= secondTime

mitigationHit(bool below, float boundary, string mode, float midpoint) =>
    float price = mode == "Close" ? close : below ? low : high
    float level = mode == "Avg" ? midpoint : boundary
    below ? price < level : price > level

method mitigated(ob[] block) =>
    if barstate.isconfirmed and block.size() > 0
        for i = block.size() - 1 to 0
            stuff = block.get(i)
            bool below = stuff.bull != stuff.isbb
            if mitigationHit(below, below ? stuff.btm : stuff.top, obmiti, stuff.avg)
                if stuff.isbb or not obshowbb
                    block.remove(i)
                else
                    stuff.isbb := true
                    stuff.bbloc := time
    true

overlap(ob[] bull, ob[] bear) =>
    for side = 0 to 1
        zones = side == 0 ? bull : bear
        int i = 0
        while i < zones.size()
            int j = i + 1
            bool removed = false
            while j < zones.size() and not removed
                first = zones.get(i)
                other = zones.get(j)
                if zonesOverlap(first.top, first.btm, other.top, other.btm)
                    if preferFirst(first.loc, other.loc, wichlap)
                        zones.remove(j)
                    else
                        zones.remove(i)
                        removed := true
                else
                    j += 1
            if not removed
                i += 1
    int i = 0
    while i < bull.size()
        int j = 0
        bool removed = false
        while j < bear.size() and not removed
            first = bull.get(i)
            other = bear.get(j)
            if zonesOverlap(first.top, first.btm, other.top, other.btm)
                if preferFirst(first.loc, other.loc, wichlap)
                    bear.remove(j)
                else
                    bull.remove(i)
                    removed := true
            else
                j += 1
        if not removed
            i += 1

overlapFVG(FVG[] blFVG, FVG[] brFVG) =>
    for side = 0 to 1
        zones = side == 0 ? blFVG : brFVG
        int i = 0
        while i < zones.size()
            int j = i + 1
            bool removed = false
            while j < zones.size() and not removed
                first = zones.get(i)
                other = zones.get(j)
                if zonesOverlap(first.top, first.btm, other.top, other.btm)
                    if first.loc >= other.loc
                        zones.remove(j)
                    else
                        zones.remove(i)
                        removed := true
                else
                    j += 1
            if not removed
                i += 1
    int i = 0
    while i < blFVG.size()
        int j = 0
        bool removed = false
        while j < brFVG.size() and not removed
            first = blFVG.get(i)
            other = brFVG.get(j)
            if zonesOverlap(first.top, first.btm, other.top, other.btm)
                if first.loc >= other.loc
                    brFVG.remove(j)
                else
                    blFVG.remove(i)
                    removed := true
            else
                j += 1
        if not removed
            i += 1

method mitigateFVG(FVG[] zones, bool bull) =>
    if barstate.isconfirmed and zones.size() > 0
        for i = zones.size() - 1 to 0
            gap = zones.get(i)
            bool below = bull != gap.isbb
            if mitigationHit(below, below ? gap.btm : gap.top, fvg_src, math.avg(gap.top, gap.btm))
                if gap.isbb or what_fvg == "FVG"
                    zones.remove(i)
                else
                    gap.isbb := true
                    gap.bbloc := time
    true

method display(ob id, ob[] full, int i) =>
    if not id.isbb
        bin.bx.unshift(box.new(top = id.top, bottom = id.btm, left = id.loc, right = time, border_color = na, bgcolor = id.css, xloc = xloc.bar_time, extend = extend.right))
    else
        bin.bx.unshift(box.new(top = id.top, bottom = id.btm, left = id.loc, right = id.bbloc, border_color = na, bgcolor = id.css, xloc = xloc.bar_time))
        bin.bx.unshift(box.new(top = id.top, bottom = id.btm, left = id.bbloc, right = time, border_color = id.css, bgcolor = id.bull ? bbup : bbdn, xloc = xloc.bar_time, border_width = 2))
        bin.bx.unshift(box.new(top = id.top, bottom = id.btm, left = time, right = time + 1, border_color = id.css, bgcolor = id.bull ? bbup : bbdn, xloc = xloc.bar_time, extend = extend.right))
    if showline
        bin.ln.unshift(line.new(x1 = id.loc, x2 = time, y1 = id.avg, y2 = id.avg, color = color.new(id.css, 0), xloc = xloc.bar_time, style = line.style_dashed))
    if showmetric
        string sourceVolumeText = na(id.vol) ? "N/A" : str.tostring(id.vol, format.volume)
        float displayedSourceRvol = signalMode == "CHoCH + Source RVOL" ? id.chochSourceRvol : id.sourceRvol
        string sourceRvolText = na(displayedSourceRvol) ? "N/A" : str.tostring(displayedSourceRvol, "#.##") + "x"
        string metricText = "OB Source Vol: " + sourceVolumeText + " | RVOL: " + sourceRvolText
        bin.lb.unshift(label.new(bar_index, id.avg, text = metricText, textcolor = color.new(id.css, 0), style = label.style_label_left, size = obtxt.txSz(), color = #ffffff00))

method dispFVG(FVG fvg, int i, bool bull) =>
    ext = fvgextend ? extend.right : extend.none
    if not fvg.isbb
        bin.bx.unshift(box.new(top = fvg.top, bottom = fvg.btm, left = fvg.loc, right = time, border_color = na, bgcolor = bull ? fvg_upcss : fvg_dncss, xloc = xloc.bar_time, extend = ext))
        if fvgline
            bin.ln.unshift(line.new(x1 = fvg.loc, x2 = time, y1 = math.avg(fvg.top, fvg.btm), y2 = math.avg(fvg.top, fvg.btm), xloc = xloc.bar_time, color = color.new(bull ? fvg_upcss : fvg_dncss, 0), extend = ext))
        if dispraid and fvg.israid
            bin.ln.unshift(line.new(x1 = fvg.raidloc, x2 = fvg.raidx2, y1 = fvg.raidy, y2 = fvg.raidy, xloc = xloc.bar_time, color = fvg.raidcs))
            bin.lb.unshift(label.new(x = int(math.avg(fvg.raidloc, fvg.raidx2)), y = fvg.raidy, text = "x", xloc = xloc.bar_time, textcolor = fvg.raidcs, style = bull ? label.style_label_up : label.style_label_down, size = size.small, color = #ffffff00))
    else
        bin.bx.unshift(box.new(top = fvg.top, bottom = fvg.btm, left = fvg.loc, right = fvg.bbloc, border_color = na, bgcolor = bull ? fvg_upcss : fvg_dncss, xloc = xloc.bar_time))
        bin.bx.unshift(box.new(top = fvg.top, bottom = fvg.btm, left = fvg.bbloc, right = time, border_color = bull ? fvg_dncss : fvg_upcss, bgcolor = bull ? fvg_dncss : fvg_upcss, xloc = xloc.bar_time, extend = ext))
        if fvgline
            bin.ln.unshift(line.new(x1 = fvg.loc, x2 = fvg.bbloc, y1 = math.avg(fvg.top, fvg.btm), y2 = math.avg(fvg.top, fvg.btm), color = color.new(bull ? fvg_upcss : fvg_dncss, 0), xloc = xloc.bar_time))
            bin.ln.unshift(line.new(x1 = fvg.bbloc, x2 = time, y1 = math.avg(fvg.top, fvg.btm), y2 = math.avg(fvg.top, fvg.btm), color = color.new(bull ? fvg_dncss : fvg_upcss, 0), xloc = xloc.bar_time, extend = ext, style = line.style_dashed))

mapping(bool draw) =>
    var float up = na
    var float dn = na
    var float point = na
    var int trend = 0
    var int idx = na
    var int sum = na
    var int project = na
    var chart.point[] charts = array.new<chart.point>()
    if barstate.isconfirmed
        if na(up)
            up := high
            idx := bar_index
        if na(dn)
            dn := low
            idx := bar_index
        if high > up
            if trend == -1
                id = IDMIDX(false, idx)
                charts.unshift(chart.point.from_time(time[id], low[id]))
                idx := bar_index
                point := low[id]
                sum := time[id]
            up := high
            dn := low
            project := time
            trend := 1
        if low < dn
            if trend == 1
                id = IDMIDX(true, idx)
                charts.unshift(chart.point.from_time(time[id], high[id]))
                idx := bar_index
                point := high[id]
                sum := time[id]
            up := high
            dn := low
            project := time
            trend := -1
        while charts.size() > MAX_MAPPING_POINTS
            charts.pop()
    if barstate.islast and draw
        var line ln = na
        var polyline pl = na
        ln.delete()
        pl.delete()
        ln := line.new(x1 = sum, x2 = project, y1 = point, y2 = trend == 1 ? up : dn, xloc = xloc.bar_time, color = color.red)
        pl := polyline.new(charts, line_color = mappingcss, xloc = xloc.bar_time, line_style = mappingStyle.lstyle())
    trend

dFVG(float fvatr) =>
    var FVG[] blFVG = array.new<FVG>()
    var FVG[] brFVG = array.new<FVG>()
    var int lastBullRaid = na
    var int lastBearRaid = na
    bool upfvg = false
    bool dnfvg = false
    float blth = low[1] + (fvatr[1] * fvgthresh)
    float brth = high[1] - (fvatr[1] * fvgthresh)
    if barstate.isconfirmed
        upfvg := low > high[2] and close[1] > blth
        dnfvg := low[2] > high and close[1] < brth
        if upfvg
            blFVG.unshift(FVG.new(top = low, btm = high[2], loc = time))
        if dnfvg
            brFVG.unshift(FVG.new(top = low[2], btm = high, loc = time))
        if blFVG.size() > MAX_ZONES
            blFVG.pop()
        if brFVG.size() > MAX_ZONES
            brFVG.pop()
        blFVG.mitigateFVG(true)
        brFVG.mitigateFVG(false)
        if fvgoverlap and (upfvg or dnfvg)
            overlapFVG(blFVG, brFVG)
    if barstate.isconfirmed
        for [i, fvg] in blFVG
            if not fvg.israid and not fvg.isbb
                if low < fvg.top and close > fvg.top
                    fvg.israid := true
                    fvg.raidloc := time
                    fvg.raidx2 := time
                    fvg.raidy := low
                    fvg.raidcs := chart.fg_color
                    lastBullRaid := bar_index
            else
                if low <= fvg.raidy and fvg.active == false and not fvg.isbb
                    fvg.active := true
                    fvg.raidx2 := time
                else if fvg.active == false and not fvg.isbb
                    fvg.raidx2 := time
        for [i, fvg] in brFVG
            if not fvg.israid and not fvg.isbb
                if high > fvg.btm and close < fvg.btm and not fvg.isbb
                    fvg.israid := true
                    fvg.raidloc := time
                    fvg.raidy := high
                    fvg.raidx2 := time
                    fvg.raidcs := chart.fg_color
                    lastBearRaid := bar_index
            else
                if high >= fvg.raidy and fvg.active == false and not fvg.isbb
                    fvg.active := true
                    fvg.raidx2 := time
                else if fvg.active == false and not fvg.isbb
                    fvg.raidx2 := time
    if barstate.islast and fvg_enable
        if blFVG.size() > 0 and fvg_num > 0
            for i = 0 to math.min(fvg_num - 1, blFVG.size() - 1)
                dispFVG(blFVG.get(i), i, true)
        if brFVG.size() > 0 and fvg_num > 0
            for i = 0 to math.min(fvg_num - 1, brFVG.size() - 1)
                dispFVG(brFVG.get(i), i, false)
    [blFVG, brFVG, lastBullRaid, lastBearRaid]

structure(color upcss, color dncss, bool draw, bool internal, int limit, float ph, float pl) =>
    var structure ms = structure.new(start = 0)
    var ob[] blob = array.new<ob>()
    var ob[] brob = array.new<ob>()
    var drawms[] bldw = array.new<drawms>()
    var drawms[] brdw = array.new<drawms>()
    bool crossup = false
    bool crossdn = false
    string structureEventType = ""
    int structureEventSide = 0
    var float up = na
    var float dn = na
    int idbull = ms.find(false, false, true)
    int idbear = ms.find(true, false, true)
    float sourceBullRvol = relativeVolume(volume[idbull], signalVolumeBase[idbull])
    float sourceBearRvol = relativeVolume(volume[idbear], signalVolumeBase[idbear])
    float sourceBullChochRvol = relativeVolume(volume[idbull], chochVolumeBase[idbull])
    float sourceBearChochRvol = relativeVolume(volume[idbear], chochVolumeBase[idbear])
    float btmP = obmode == "Length" ? (high[idbear] - 1 * atr[idbear]) < low[idbear] ? low[idbear] : (high[idbear] - 1 * atr[idbear]) : low[idbear]
    float topP = obmode == "Length" ? (low[idbull] + 1 * atr[idbull]) > high[idbull] ? high[idbull] : (low[idbull] + 1 * atr[idbull]) : high[idbull]
    var int[] phn = array.new<int>()
    var int[] pln = array.new<int>()
    var float[] php = array.new<float>()
    var float[] plp = array.new<float>()
    if barstate.isconfirmed
        if internal
            blob.clear()
            brob.clear()
        if not na(ph)
            phn.clear()
            php.clear()
            phn.unshift(bar_index[mslen])
            php.unshift(high[mslen])
        if not na(pl)
            pln.clear()
            plp.clear()
            pln.unshift(bar_index[mslen])
            plp.unshift(low[mslen])
        if php.size() > 0 and high > php.get(0)
            php.clear()
            phn.clear()
        if plp.size() > 0 and low < plp.get(0)
            plp.clear()
            pln.clear()
        if na(up)
            up := high
        if na(dn)
            dn := low
        if high > up
            up := high
            dn := low
            crossup := true
        if low < dn
            up := high
            dn := low
            crossdn := true
        if ms.start == 0
            ms := structure.new(bar_index, na, high, low, bar_index, bar_index, 0, 1, na, bar_index)
            if draw
                bldw.unshift(drawms.new(time, time, high, "CHoCH", upcss, line.style_dashed))
                brdw.unshift(drawms.new(time, time, low, "CHoCH", dncss, line.style_dashed))
        ms.upsweep := false
        ms.dnsweep := false
        if ms.start == 1
            switch
                low <= ms.choch and close >= ms.choch and buildsweep =>
                    ms.dnsweep := true
                    ms.choch := low
                    ms.xloc := bar_index
                    if draw
                        dw = brdw.get(0)
                        dw.x2 := time
                        dw.style := line.style_dotted
                        dw.txt := "x"
                        brdw.unshift(drawms.new(time, time, low, "CHoCH", dncss, line.style_dashed))
                high >= ms.bos and close <= ms.bos and buildsweep =>
                    ms.upsweep := true
                    ms.bos := high
                    ms.xloc := bar_index
                    if draw
                        dw = bldw.get(0)
                        dw.x2 := time
                        dw.style := line.style_dotted
                        dw.txt := "x"
                        bldw.unshift(drawms.new(time, time, high, "CHoCH", upcss, line.style_dashed))
                close <= ms.choch =>
                    ms.txt := "choch"
                    structureEventType := "choch"
                    structureEventSide := -1
                    brob.fnOB(false, btmP, idbear, sourceBearRvol, sourceBearChochRvol)
                    ms.trend := -1
                    ms.choch := ms.bos
                    ms.bos := na
                    ms.start := 2
                    ms.loc := bar_index
                    ms.main := low
                    ms.temp := ms.loc
                    ms.xloc := bar_index
                    if draw
                        dw = brdw.get(0)
                        dw.x2 := time
                        dw.style := internal ? line.style_dashed : line.style_solid
                close >= ms.bos =>
                    ms.txt := "choch"
                    structureEventType := "choch"
                    structureEventSide := 1
                    blob.fnOB(true, topP, idbull, sourceBullRvol, sourceBullChochRvol)
                    ms.trend := 1
                    ms.bos := na
                    ms.start := 2
                    ms.loc := bar_index
                    ms.main := high
                    ms.temp := ms.loc
                    ms.xloc := bar_index
                    if draw
                        dw = bldw.get(0)
                        dw.x2 := time
                        dw.style := internal ? line.style_dashed : line.style_solid
        if ms.start == 2
            switch ms.trend
                -1 =>
                    if low <= ms.main
                        ms.main := low
                        ms.temp := bar_index
                    if bar_index % mslen * 2 == 0
                        if not na(ms.bos) and msmode == "Adjusted Points" and php.size() > 0
                            if php.get(0) < ms.choch
                                ms.choch := php.get(0)
                                ms.loc := phn.get(0)
                                ms.xloc := phn.get(0)
                                ms.temp := phn.get(0)
                                if draw
                                    choch = bldw.get(0)
                                    choch.x1 := time[historyOffset(phn.get(0))]
                                    choch.x2 := time
                                    choch.y := php.get(0)
                    if na(ms.bos)
                        if crossup and close > open and close[1] > open[1]
                            ms.bos := ms.main
                            ms.loc := ms.temp
                            ms.xloc := ms.loc
                            if draw
                                brdw.unshift(drawms.new(time[historyOffset(ms.loc)], time, low[historyOffset(ms.loc)], "BOS", dncss, line.style_dashed))
                    if not na(ms.bos) and draw
                        dw = brdw.get(0)
                        dw.x2 := time
                    if draw
                        choch = bldw.get(0)
                        choch.x2 := time
                    switch
                        low <= ms.bos and close >= ms.bos and not na(ms.bos) and buildsweep =>
                            ms.dnsweep := true
                            ms.bos := low
                            if draw
                                dw = brdw.get(0)
                                dw.x2 := time
                                dw.style := line.style_dotted
                                dw.txt := "x"
                                brdw.unshift(drawms.new(time, time, low, "BOS", dncss, line.style_dashed))
                            ms.xloc := bar_index
                        close <= ms.bos and not na(ms.bos) =>
                            ms.txt := "bos"
                            ms.zz := ms.bos
                            ms.zn := bar_index
                            structureEventType := "bos"
                            structureEventSide := -1
                            brob.fnOB(false, btmP, idbear, sourceBearRvol, sourceBearChochRvol)
                            id = ms.find(true, false, false)
                            ms.xloc := bar_index
                            ms.bos := na
                            ms.choch := high[id]
                            ms.loc := bar_index[id]
                            if draw
                                dw = brdw.get(0)
                                dw.x2 := time
                                dw.style := internal ? line.style_dashed : line.style_solid
                                choch = bldw.get(0)
                                choch.x1 := time[id]
                                choch.x2 := time
                                choch.y := high[id]
                    switch
                        high >= ms.choch and close <= ms.choch and buildsweep =>
                            ms.upsweep := true
                            ms.choch := high
                            ms.xloc := bar_index
                            if draw
                                dw = bldw.get(0)
                                dw.x2 := time
                                dw.style := line.style_dotted
                                dw.txt := "x"
                                bldw.unshift(drawms.new(time, time, high, "CHoCH", upcss, line.style_dashed))
                        close >= ms.choch =>
                            ms.txt := "choch"
                            structureEventType := "choch"
                            structureEventSide := 1
                            ms.zz := ms.choch
                            ms.zn := bar_index
                            blob.fnOB(true, topP, idbull, sourceBullRvol, sourceBullChochRvol)
                            id = ms.find(false, false, false)
                            switch
                                na(ms.bos) =>
                                    ms.choch := low[id]
                                    if draw
                                        brdw.unshift(drawms.new(time, time, low, "BOS", dncss, line.style_dashed))
                                        choch = brdw.get(0)
                                        choch.x1 := time[historyOffset(ms.temp)]
                                => ms.choch := ms.bos
                            ms.bos := na
                            ms.main := high
                            ms.trend := 1
                            ms.loc := bar_index
                            ms.xloc := bar_index
                            ms.temp := ms.loc
                            if draw
                                dw = bldw.get(0)
                                dw.x2 := time
                                dw.txt := "CHoCH"
                                dw.style := internal ? line.style_dashed : line.style_solid
                                choch = brdw.get(0)
                                choch.x2 := time
                                choch.y := ms.choch
                                choch.txt := "CHoCH"
                            ms.xloc := bar_index
                1 =>
                    if high >= ms.main
                        ms.main := high
                        ms.temp := bar_index
                    if na(ms.bos)
                        if crossdn and close < open and close[1] < open[1]
                            ms.bos := ms.main
                            ms.loc := ms.temp
                            ms.xloc := ms.loc
                            if draw
                                bldw.unshift(drawms.new(time[historyOffset(ms.loc)], time, high[historyOffset(ms.loc)], "BOS", upcss, line.style_dashed))
                    if bar_index % mslen * 2 == 0
                        if not na(ms.bos) and msmode == "Adjusted Points" and plp.size() > 0
                            if plp.get(0) > ms.choch
                                ms.choch := plp.get(0)
                                ms.loc := pln.get(0)
                                ms.xloc := pln.get(0)
                                ms.temp := pln.get(0)
                                if draw
                                    choch = brdw.get(0)
                                    choch.x1 := time[historyOffset(pln.get(0))]
                                    choch.x2 := time
                                    choch.y := plp.get(0)
                    if not na(ms.bos) and draw
                        dw = bldw.get(0)
                        dw.x2 := time
                    if draw
                        choch = brdw.get(0)
                        choch.x2 := time
                    switch
                        high >= ms.bos and close <= ms.bos and not na(ms.bos) and buildsweep =>
                            ms.upsweep := true
                            ms.bos := high
                            if draw
                                dw = bldw.get(0)
                                dw.x2 := time
                                dw.style := line.style_dotted
                                dw.txt := "x"
                                bldw.unshift(drawms.new(time, time, high, "BOS", upcss, line.style_dashed))
                            ms.xloc := bar_index
                        close >= ms.bos and not na(ms.bos) =>
                            ms.txt := "bos"
                            ms.zz := ms.bos
                            ms.zn := bar_index
                            structureEventType := "bos"
                            structureEventSide := 1
                            blob.fnOB(true, topP, idbull, sourceBullRvol, sourceBullChochRvol)
                            id = ms.find(false, false, false)
                            ms.xloc := bar_index
                            ms.bos := na
                            ms.choch := low[id]
                            ms.loc := bar_index[id]
                            if draw
                                dw = bldw.get(0)
                                dw.x2 := time
                                dw.style := internal ? line.style_dashed : line.style_solid
                                choch = brdw.get(0)
                                choch.x1 := time[id]
                                choch.x2 := time
                                choch.y := low[id]
                    switch
                        low <= ms.choch and close >= ms.choch and buildsweep =>
                            ms.dnsweep := true
                            ms.choch := low
                            ms.xloc := bar_index
                            if draw
                                dw = brdw.get(0)
                                dw.x2 := time
                                dw.style := line.style_dotted
                                dw.txt := "x"
                                brdw.unshift(drawms.new(time, time, low, "CHoCH", dncss, line.style_dashed))
                        close <= ms.choch =>
                            ms.txt := "choch"
                            structureEventType := "choch"
                            structureEventSide := -1
                            ms.zz := ms.choch
                            ms.zn := bar_index
                            brob.fnOB(false, btmP, idbear, sourceBearRvol, sourceBearChochRvol)
                            id = ms.find(true, false, false)
                            switch
                                na(ms.bos) =>
                                    ms.choch := high[id]
                                    if draw
                                        bldw.unshift(drawms.new(time, time, high, "BOS", upcss, line.style_dashed))
                                        choch = bldw.get(0)
                                        choch.x1 := time[historyOffset(ms.temp)]
                                => ms.choch := ms.bos
                            ms.bos := na
                            ms.main := low
                            ms.trend := -1
                            ms.loc := bar_index
                            ms.temp := ms.loc
                            if draw
                                dw = brdw.get(0)
                                dw.x2 := time
                                dw.txt := "CHoCH"
                                dw.style := internal ? line.style_dashed : line.style_solid
                                choch = bldw.get(0)
                                choch.y := ms.choch
                                choch.x2 := time
                                choch.txt := "CHoCH"
                            ms.xloc := bar_index
    if barstate.isconfirmed
        blob.mitigated()
        brob.mitigated()
        bool newBlock = (blob.size() > 0 and blob.get(0).loc == time) or (brob.size() > 0 and brob.get(0).loc == time)
        if overlap and newBlock
            overlap(blob, brob)
        while bldw.size() > limit
            bldw.pop()
        while brdw.size() > limit
            brdw.pop()
    if obshow and oblast > 0 and barstate.islast
        if blob.size() > 0
            for i = 0 to math.min(oblast - 1, blob.size() - 1)
                display(blob.get(i), blob, i)
        if brob.size() > 0
            for i = 0 to math.min(oblast - 1, brob.size() - 1)
                display(brob.get(i), brob, i)
    if barstate.islast and draw and bldw.size() > 0 and brdw.size() > 0
        for i = 0 to bldw.size() - 1
            obj = bldw.get(i)
            if i < limit and (not windowsis or obj.x2 >= time[math.min(bar_index, mswindow)])
                bin.ln.unshift(line.new(x1 = obj.x1, x2 = obj.x2, y1 = obj.y, y2 = obj.y, color = obj.css, style = obj.style, xloc = xloc.bar_time))
                bin.lb.unshift(label.new(x = int(math.avg(bin.ln.get(0).get_x1(), bin.ln.get(0).get_x2())), y = obj.y, xloc = xloc.bar_time, color = #ffffff00, style = label.style_label_down, textcolor = obj.css, size = mstext.txSz(), text = obj.txt))
                if msbubble
                    bin.lb.unshift(label.new(x = obj.x1, y = obj.y, xloc = xloc.bar_time, color = color.new(obj.css, 80), style = label.style_circle, size = size.tiny))
        for i = 0 to brdw.size() - 1
            obj = brdw.get(i)
            if i < limit and (not windowsis or obj.x2 >= time[math.min(bar_index, mswindow)])
                bin.ln.unshift(line.new(x1 = obj.x1, x2 = obj.x2, y1 = obj.y, y2 = obj.y, color = obj.css, style = obj.style, xloc = xloc.bar_time))
                bin.lb.unshift(label.new(x = int(math.avg(bin.ln.get(0).get_x1(), bin.ln.get(0).get_x2())), y = obj.y, xloc = xloc.bar_time, color = #ffffff00, style = label.style_label_up, textcolor = obj.css, size = mstext.txSz(), text = obj.txt))
                if msbubble
                    bin.lb.unshift(label.new(x = obj.x1, y = obj.y, xloc = xloc.bar_time, color = color.new(obj.css, 80), style = label.style_circle, size = size.tiny))
    int chochDirection = structureEventDirection(structureEventType, structureEventSide)
    bool bullChochEvent = chochDirection == 1
    bool bearChochEvent = chochDirection == -1
    float bullChochSourceRvol = bullChochEvent ? sourceBullChochRvol : na
    float bearChochSourceRvol = bearChochEvent ? sourceBearChochRvol : na
    [ms, blob, brob, bullChochEvent, bearChochEvent, bullChochSourceRvol, bearChochSourceRvol]

// ============================================================================
// SMC STRUCTURE / FVG / MAPPING / HEATMAP EXECUTION
// ============================================================================
[ms, bullOBs, bearOBs, bullChochEvent, bearChochEvent, bullChochSourceRvol, bearChochSourceRvol] = structure(swingcssup, swingcssdn, showSwing, false, swingLimit, phRaw, plRaw)

var color css = na
method darkcss(color c, float factor) =>
    color.rgb(color.r(c) * (1 - factor), color.g(c) * (1 - factor), color.b(c) * (1 - factor), 0)

if not na(ms) and barstate.isconfirmed and (not windowsis or bar_index > last_bar_index - mswindow)
    css := ms.trend == 1 ? swingcssup : swingcssdn
    css := ms.txt == "bos" ? css : css.darkcss(0.3)

barcolor(candlecss ? css : na)

[bullGaps, bearGaps, bullRaidBar, bearRaidBar] = dFVG(atr200)
int mappingTrend = mapping(showMapping)
var int bullSweepBar = na
var int bearSweepBar = na
if barstate.isconfirmed
    if ms.dnsweep
        bullSweepBar := bar_index
    if ms.upsweep
        bearSweepBar := bar_index

bool bullSweepOK = recentEvent(bullSweepBar, bar_index, signalSweepBars) or recentEvent(bullRaidBar, bar_index, signalSweepBars)
bool bearSweepOK = recentEvent(bearSweepBar, bar_index, signalSweepBars) or recentEvent(bearRaidBar, bar_index, signalSweepBars)
float confirmationRvol = relativeVolume(volume, signalVolumeBase)
int bullCandidate = signalCandidate(bullOBs, bullGaps, 1, ms.trend, mappingTrend, bullSweepOK, confirmationRvol)
int bearCandidate = signalCandidate(bearOBs, bearGaps, -1, ms.trend, mappingTrend, bearSweepOK, confirmationRvol)
[legacyBuyArrow, legacySellArrow] = resolveSignals(barstate.isconfirmed, bullCandidate, bearCandidate)
bool chochBuyArrow = chochSourceSignal(barstate.isconfirmed, bullChochEvent, bullChochSourceRvol, chochSourceRvolMin)
bool chochSellArrow = chochSourceSignal(barstate.isconfirmed, bearChochEvent, bearChochSourceRvol, chochSourceRvolMin)
bool useChochMode = signalMode == "CHoCH + Source RVOL"
bool baseBuyArrow = useChochMode ? chochBuyArrow : legacyBuyArrow
bool baseSellArrow = useChochMode ? chochSellArrow : legacySellArrow

bool heatmapHasOi = not na(heatmapOiDelta)
float heatmapActivity = heatmapHasOi ? heatmapOiAbsDelta : volume
float heatmapActivityMean = heatmapHasOi ? heatmapOiMean : heatmapVolMean
float heatmapActivityDev = heatmapHasOi ? heatmapOiDev : heatmapVolDev
float heatmapZ = not na(heatmapActivityDev) and heatmapActivityDev > 0 ? (heatmapActivity - heatmapActivityMean) / heatmapActivityDev : na
float heatmapBinSize = math.max(syminfo.mintick * 10, nz(heatmapAtr, syminfo.mintick * 100) * heatmapBinAtr)
var liqZone[] heatmapZones = array.new<liqZone>()
var int heatmapLastEventBar = na
var float filterUpsidePressure = na
var float filterDownsidePressure = na
var bool heatmapFilterReady = false

if barstate.isconfirmed
    if heatmapZones.size() > 0
        for i = heatmapZones.size() - 1 to 0
            zone = heatmapZones.get(i)
            if bar_index - zone.updated > heatmapMaxAge
                heatmapZones.remove(i)
            else if not zone.touched and zone.born < bar_index
                bool touched = zone.side == -1 ? low <= zone.price : high >= zone.price
                if touched
                    zone.touched := true
                    zone.touchedBar := bar_index
    [filterLongIndex, filterLongDistance, filterLongWeight] = heatmapNearest(heatmapZones, -1, close)
    [filterShortIndex, filterShortDistance, filterShortWeight] = heatmapNearest(heatmapZones, 1, close)
    heatmapFilterReady := filterLongIndex >= 0 and filterShortIndex >= 0
    filterDownsidePressure := filterLongIndex >= 0 and filterLongDistance > 0 and close > 0 ? filterLongWeight / (filterLongDistance / close * 100) : na
    filterUpsidePressure := filterShortIndex >= 0 and filterShortDistance > 0 and close > 0 ? filterShortWeight / (filterShortDistance / close * 100) : na
    bool cooldownOK = na(heatmapLastEventBar) or bar_index - heatmapLastEventBar >= heatmapCooldown
    bool expansionOK = not heatmapHasOi or heatmapOiDelta > 0
    bool heatmapEvent = (showHeatmap or signalUseHeatmap) and cooldownOK and expansionOK and not na(heatmapZ) and heatmapZ >= heatmapZMin
    if heatmapEvent
        float directionChange = close - close[1]
        float baseWeight = math.max(heatmapZ, 0.1)
        float longWeight = baseWeight * (directionChange >= 0 ? 1.0 : 0.65)
        float shortWeight = baseWeight * (directionChange < 0 ? 1.0 : 0.65)
        heatmapAddZone(heatmapZones, close * (1.0 - 1.0 / 25.0), longWeight * 0.75, -1, heatmapBinSize)
        heatmapAddZone(heatmapZones, close * (1.0 + 1.0 / 25.0), shortWeight * 0.75, 1, heatmapBinSize)
        heatmapAddZone(heatmapZones, close * (1.0 - 1.0 / 50.0), longWeight, -1, heatmapBinSize)
        heatmapAddZone(heatmapZones, close * (1.0 + 1.0 / 50.0), shortWeight, 1, heatmapBinSize)
        heatmapAddZone(heatmapZones, close * (1.0 - 1.0 / 100.0), longWeight * 0.65, -1, heatmapBinSize)
        heatmapAddZone(heatmapZones, close * (1.0 + 1.0 / 100.0), shortWeight * 0.65, 1, heatmapBinSize)
        heatmapLastEventBar := bar_index
    while heatmapZones.size() > heatmapMaxZones
        int oldest = 0
        for i = 1 to heatmapZones.size() - 1
            if heatmapZones.get(i).updated < heatmapZones.get(oldest).updated
                oldest := i
        heatmapZones.remove(oldest)

if barstate.islast and showHeatmap and heatmapZones.size() > 0
    float heatmapMaxWeight = 0.0
    for zone in heatmapZones
        if not zone.touched
            heatmapMaxWeight := math.max(heatmapMaxWeight, zone.weight)
    for zone in heatmapZones
        float density = heatmapMaxWeight > 0 ? zone.weight / heatmapMaxWeight : 0
        color zoneColor = color.from_gradient(density, 0, 1, heatmapLowColor, heatmapHighColor)
        int zoneAlpha = zone.touched ? 92 : int(math.round(82 - density * 42))
        float halfHeight = heatmapBinSize * 0.5
        int endTime = zone.touched ? time[historyOffset(zone.touchedBar)] : time
        bin.bx.unshift(box.new(left = time[historyOffset(zone.born)], right = endTime, top = zone.price + halfHeight, bottom = zone.price - halfHeight, xloc = xloc.bar_time, extend = zone.touched ? extend.none : extend.right, border_color = na, bgcolor = color.new(zoneColor, zoneAlpha)))

bool buyHeatmapOK = heatmapSignalGate(signalUseHeatmap, heatmapFilterReady, filterUpsidePressure, filterDownsidePressure, signalHeatmapRatio)
bool sellHeatmapOK = heatmapSignalGate(signalUseHeatmap, heatmapFilterReady, filterDownsidePressure, filterUpsidePressure, signalHeatmapRatio)
bool qualifiedBuyArrow = baseBuyArrow and buyHeatmapOK
bool qualifiedSellArrow = baseSellArrow and sellHeatmapOK
var int[] originalBuyLosses = array.new<int>()
var int[] originalSellLosses = array.new<int>()
if barstate.isconfirmed and not na(close[reversalHorizon])
    if qualifiedBuyArrow[reversalHorizon]
        recordSettledOutcome(originalBuyLosses, close < close[reversalHorizon], reversalWindow)
    if qualifiedSellArrow[reversalHorizon]
        recordSettledOutcome(originalSellLosses, close > close[reversalHorizon], reversalWindow)
int buyHistorySamples = originalBuyLosses.size()
int sellHistorySamples = originalSellLosses.size()
int buyHistoryLosses = buyHistorySamples > 0 ? originalBuyLosses.sum() : 0
int sellHistoryLosses = sellHistorySamples > 0 ? originalSellLosses.sum() : 0
bool reverseBuySide = directionMode == "Reverse all" or (directionMode == "Past-loss reversal" and lossReversalDecision(buyHistorySamples, buyHistoryLosses, reversalMinSamples, reversalLossMinPct))
bool reverseSellSide = directionMode == "Reverse all" or (directionMode == "Past-loss reversal" and lossReversalDecision(sellHistorySamples, sellHistoryLosses, reversalMinSamples, reversalLossMinPct))
bool beforeQualityBuy = (qualifiedBuyArrow and not reverseBuySide) or (qualifiedSellArrow and reverseSellSide)
bool beforeQualitySell = (qualifiedSellArrow and not reverseSellSide) or (qualifiedBuyArrow and reverseBuySide)

var int confirmedHtfDirection = 0
if barstate.isconfirmed and htfBoundary
    bool ready = closedHtfSnapshotValid(validHTF, rawHtfCloseTime[1], time_close[1], time(trendHTF), rawHtfClose[1], rawHtfAverage[1])
    confirmedHtfDirection := ready ? (rawHtfClose[1] > rawHtfAverage[1] ? 1 : rawHtfClose[1] < rawHtfAverage[1] ? -1 : 0) : 0

float qualityAtrRatio = relativeVolume(qualityAtr, qualityAtrBaseline)
float qualityRvol = relativeVolume(volume, qualityVolumeBaseline)
var int lastEmittedBuy = na
var int lastEmittedSell = na
bool commonQualityOK = minimumGate(qualityUseATR, qualityAtrRatio, qualityAtrMin) and minimumGate(qualityUseVolume, qualityRvol, qualityRvolMin)
bool buyQualityOK = commonQualityOK and directionGate(qualityUseHTF, 1, confirmedHtfDirection) and cooldownGate(qualityUseCooldown, lastEmittedBuy, bar_index, qualityCooldownBars)
bool sellQualityOK = commonQualityOK and directionGate(qualityUseHTF, -1, confirmedHtfDirection) and cooldownGate(qualityUseCooldown, lastEmittedSell, bar_index, qualityCooldownBars)
bool legacyFinalBuy = beforeQualityBuy and buyQualityOK
bool legacyFinalSell = beforeQualitySell and sellQualityOK

// ============================================================================
// V3.0.0 CAUSAL CLOSED-HTF LATCHES & SIGNAL ENGINES (15m & 1h)
// ============================================================================
var float h1Open = na
var float h1High = na
var float h1Low = na
var float h1Close = na
var float h1Ema50 = na
var float h1Atr14 = na
var float h1Rsi14 = na

var float h4Close = na
var float h4Ema50 = na
var float h4PrevHigh10 = na
var float h4PrevLow10 = na

var float d1High = na
var float d1Low = na

if barstate.isconfirmed
    if v3HtfBoundary and not na(rawHtfV3CloseTime[1]) and rawHtfV3CloseTime[1] <= time
        h1Open := rawHtfO[1]
        h1High := rawHtfH[1]
        h1Low := rawHtfL[1]
        h1Close := rawHtfC[1]
        h1Ema50 := rawHtfEma50[1]
        h1Atr14 := rawHtfAtr14[1]
        h1Rsi14 := rawHtfRsi14[1]
        h4Close := rawHtfC[1]
        h4Ema50 := rawHtfEma50[1]
        h4PrevHigh10 := rawHtfPrevH10[1]
        h4PrevLow10 := rawHtfPrevL10[1]
    if d1Boundary and not na(rawD1CloseTime[1]) and rawD1CloseTime[1] <= time
        d1High := rawD1High[1]
        d1Low := rawD1Low[1]

int v3_15m_side = 0
float v3_15m_limit = na
if barstate.isconfirmed and chart.is_standard and bar_index >= 250 and not na(qualityAtr) and qualityAtr > 0 and not na(ltfEma50) and not na(h1Atr14) and h1Atr14 > 0 and not na(h1Ema50)
    float atrPct = (qualityAtr / close) * 100.0
    float h1Range = h1High - h1Low
    if atrPct >= 0.18 and h1Range > 0
        bool h1Bull = (h1Close - h1Open) >= 1.0 * h1Atr14 and (h1Close - h1Low) / h1Range >= 0.65 and h1Close > h1Ema50 and close > ltfEma50
        bool h1Bear = (h1Open - h1Close) >= 1.0 * h1Atr14 and (h1High - h1Close) / h1Range >= 0.65 and h1Close < h1Ema50 and close < ltfEma50
        int cand15 = h1Bull and not h1Bear ? 1 : h1Bear and not h1Bull ? -1 : 0
        if cand15 != 0 and not na(h1Rsi14) and not na(ltfEma20)
            float dirH1Rsi = cand15 == 1 ? h1Rsi14 : 100.0 - h1Rsi14
            float ltfEmaDistAtr = (cand15 * (close - ltfEma20)) / qualityAtr
            if dirH1Rsi >= 72.0 and ltfEmaDistAtr > 1.8
                cand15 := 0
        if cand15 != 0
            float lim15 = close - cand15 * 0.55 * qualityAtr
            if lim15 > 0
                v3_15m_side := cand15
                v3_15m_limit := lim15

int v3_1h_rawSide = 0
float v3_1h_rawLimit = na
if barstate.isconfirmed and chart.is_standard and bar_index >= 250 and not na(qualityAtr) and qualityAtr > 0 and not na(h4Close) and not na(h4Ema50)
    bool htfBull = h4Close > h4Ema50
    bool htfBear = h4Close < h4Ema50
    bool b1h = false
    bool s1h = false
    bool b4h = false
    bool s4h = false
    bool bPd = false
    bool sPd = false
    for k = 1 to 4
        float lvL1 = ltfPrevLow20[k]
        float lvH1 = ltfPrevHigh20[k]
        if not na(lvL1) and not na(lvH1)
            bool allB1 = true
            bool allA1 = true
            for m = 1 to k
                if not (close[m] < lvL1)
                    allB1 := false
                if not (close[m] > lvH1)
                    allA1 := false
            if allB1 and close > lvL1 and close > open
                b1h := true
            if allA1 and close < lvH1 and close < open
                s1h := true

        float lvL4 = h4PrevLow10[k]
        float lvH4 = h4PrevHigh10[k]
        if not na(lvL4) and not na(lvH4)
            bool allB4 = true
            bool allA4 = true
            for m = 1 to k
                if not (close[m] < lvL4)
                    allB4 := false
                if not (close[m] > lvH4)
                    allA4 := false
            if allB4 and close > lvL4 and close > open
                b4h := true
            if allA4 and close < lvH4 and close < open
                s4h := true

        if k <= 2
            float lvLD = d1Low[k]
            float lvHD = d1High[k]
            if not na(lvLD) and not na(lvHD)
                bool allBD = true
                bool allAD = true
                for m = 1 to k
                    if not (close[m] < lvLD)
                        allBD := false
                    if not (close[m] > lvHD)
                        allAD := false
                if allBD and close > lvLD and close > open
                    bPd := true
                if allAD and close < lvHD and close < open
                    sPd := true

    bool rawBull = (b1h or b4h or bPd) and htfBull
    bool rawBear = (s1h or s4h or sPd) and htfBear
    if rawBull != rawBear
        int rSide = rawBull ? 1 : -1
        float rLim = close - rSide * 0.18 * qualityAtr
        if rLim > 0
            v3_1h_rawSide := rSide
            v3_1h_rawLimit := rLim

// Shadow virtual ledger for 1h AdaptiveTrapPolarity
var int   vSide = 0
var int   vPendingSide = 0
var float vPendingAtr = na
var float vPendingLimit = na
var int   vPendingExpiryBar = na
var int   vLastAccepted = na
var int   vEntryBar = na
var bool  vFilledAtOpen = false
var float vEntry = na
var float vStop = na
var float vTarget = na
var float vInitialDist = na
var bool  vBeArmed = false
var int[]   vLongSlHist = array.new<int>()
var float[] vLongNetHist = array.new<float>()
var int[]   vShortSlHist = array.new<int>()
var float[] vShortNetHist = array.new<float>()

int v3_1h_side = 0
float v3_1h_limit = na

if barstate.isconfirmed and chart.is_standard
    if vSide == 0 and vPendingSide != 0
        bool vBullPend = vPendingSide == 1
        bool vTouched = vBullPend ? low <= vPendingLimit : high >= vPendingLimit
        if vTouched
            bool vFillAtOpen = vBullPend ? open <= vPendingLimit : open >= vPendingLimit
            float vRawFill = vBullPend ? math.min(open, vPendingLimit) : math.max(open, vPendingLimit)
            float vFill = adverseFill(vRawFill, vPendingSide, true, V3_SHADOW_SLIP_PCT)
            [vOk, vS, vT, vD] = resolvePaperLevels(vPendingSide, vFill, vPendingAtr, 3.2, 1.4, 1.15)
            if vOk
                vSide := vPendingSide
                vEntry := vFill
                vStop := vS
                vTarget := vT
                vInitialDist := vD
                vEntryBar := bar_index
                vFilledAtOpen := vFillAtOpen
                vBeArmed := false
            vPendingSide := 0
            vPendingAtr := na
            vPendingLimit := na
            vPendingExpiryBar := na
        else if bar_index >= vPendingExpiryBar
            vPendingSide := 0
            vPendingAtr := na
            vPendingLimit := na
            vPendingExpiryBar := na

    if vSide != 0
        [vExitRaw, vExitReason] = paperExitConservative(vSide, "LIMIT_PULLBACK", bar_index == vEntryBar, vFilledAtOpen, vBeArmed, open, high, low, close, vStop, vTarget, bar_index - vEntryBar + 1, 96)
        if vExitReason != 0
            float vOutPrice = adverseFill(vExitRaw, vSide, false, V3_SHADOW_SLIP_PCT)
            float vNet = vSide * (vOutPrice - vEntry) / vEntry * 100.0 - V3_SHADOW_FEE_PCT
            vNet := math.abs(vNet) < EPS_ZERO ? 0.0 : vNet
            bool isPureSl = vExitReason == 1 and not vBeArmed
            if vSide == 1
                recordShadowOutcome(vLongSlHist, vLongNetHist, isPureSl, vNet, 6)
            else
                recordShadowOutcome(vShortSlHist, vShortNetHist, isPureSl, vNet, 6)
            vSide := 0

    if vSide != 0 and not vBeArmed
        if vSide * (close - vEntry) >= 0.43 * vInitialDist
            float vRaisedStop = vEntry * (1.0 + vSide * 0.34 / 100.0)
            if vSide * (vRaisedStop - vStop) > 0 and vSide * (vTarget - vRaisedStop) > 0
                vStop := vRaisedStop
                vBeArmed := true

    if v3_1h_rawSide != 0
        bool shouldFlip = v3_1h_rawSide == 1
             ? adaptivePolarityFlip(vLongSlHist, vLongNetHist, 6, 2)
             : adaptivePolarityFlip(vShortSlHist, vShortNetHist, 6, 2)
        int adaptSide = shouldFlip ? -v3_1h_rawSide : v3_1h_rawSide
        float adaptLimit = close - adaptSide * 0.18 * qualityAtr
        if adaptLimit > 0
            v3_1h_side := adaptSide
            v3_1h_limit := adaptLimit

    if vSide == 0 and vPendingSide == 0 and v3_1h_rawSide != 0 and bar_index >= 250 and cooldownGate(true, vLastAccepted, bar_index, 4)
        [vPreOk, _vs, _vt, _vd] = resolvePaperLevels(v3_1h_rawSide, v3_1h_rawLimit, qualityAtr, 3.2, 1.4, 1.15)
        if vPreOk
            vPendingSide := v3_1h_rawSide
            vPendingAtr := qualityAtr
            vPendingLimit := v3_1h_rawLimit
            vPendingExpiryBar := bar_index + 6
            vLastAccepted := bar_index

// ============================================================================
// EFFECTIVE EXECUTION & STRATEGY ORDER ROUTING (100% sim_engine parity)
// ============================================================================
bool applyV3Auto = useV3Mode and paperUseAutoPreset
string effEntryMode   = applyV3Auto ? "LIMIT_PULLBACK" : (useV3Mode and not paperUseAutoPreset ? paperEntryModeInput : (not useV3Mode and not paperUseAutoPreset ? paperEntryModeInput : "MARKET_NEXT_OPEN"))
int    effExpiryBars  = applyV3Auto ? 6 : paperLimitExpiryInput
float  effStopAtr     = applyV3Auto ? (is15mProfile ? 3.0 : 3.2) : paperStopAtr
float  effMinStopPct  = applyV3Auto ? (is15mProfile ? 1.0 : 1.4) : paperMinStopPctInput
float  effRewardRisk  = applyV3Auto ? 1.15 : paperRewardRisk
int    effMaxHoldBars = applyV3Auto ? (is15mProfile ? 120 : 96) : paperMaxBars
int    effCooldown    = applyV3Auto ? (is15mProfile ? 8 : 4) : paperCooldownBars
float  effBeTriggerR  = applyV3Auto ? 0.43 : paperBeTriggerRInput
float  effBeOffsetPct = applyV3Auto ? (is15mProfile ? 0.28 : 0.34) : paperBeOffsetPctInput

int candSide = useV3Mode
     ? (is15mProfile ? v3_15m_side : v3_1h_side)
     : (legacyFinalBuy ? 1 : legacyFinalSell ? -1 : 0)
float candLimit = useV3Mode
     ? (is15mProfile ? v3_15m_limit : v3_1h_limit)
     : (effEntryMode == "LIMIT_PULLBACK" ? close : na)

var int   paperSide = 0
var int   paperPendingSide = 0
var float paperPendingAtr = na
var float paperPendingLimit = na
var string paperPendingEntryMode = "LIMIT_PULLBACK"
var int   paperSignalBar = na
var int   paperPendingExpiryBar = na
var int   paperSignalTime = na
var int   paperEntryBar = na
var int   paperEntryTime = na
var bool  paperFilledAtOpen = false
var string paperActiveEntryMode = "LIMIT_PULLBACK"
var int   lastPaperSignal = na
var float paperEntry = na
var float paperStop = na
var float paperInitialStop = na
var float paperTarget = na
var float paperInitialDist = na
var bool  paperBeArmed = false

var int   paperWins = 0
var int   paperLosses = 0
var int   paperTies = 0
var float paperGains = 0.0
var float paperLossSum = 0.0
var float paperTotalNet = 0.0
var paperVisual[] paperHistory = array.new<paperVisual>()

bool  paperInLong = false
bool  paperInShort = false
int   paperOutReason = 0
float paperInPrice = na
float paperOutPrice = na
float paperClosedNet = na
int   paperClosedSide = 0
float paperClosedEntry = na

if barstate.isconfirmed and chart.is_standard
    int expiredSide = 0
    int exitedSide = 0
    int exitedReason = 0
    int queuedSide = 0

    if paperSide == 0 and paperPendingSide != 0
        if paperPendingEntryMode == "MARKET_NEXT_OPEN"
            if paperSignalBar == bar_index - 1
                float fill = adverseFill(open, paperPendingSide, true, paperSlippagePct)
                [ok, s, t, d] = resolvePaperLevels(paperPendingSide, fill, paperPendingAtr, effStopAtr, effMinStopPct, effRewardRisk)
                if ok
                    paperSide := paperPendingSide
                    paperEntry := fill
                    paperStop := s
                    paperInitialStop := s
                    paperTarget := t
                    paperInitialDist := d
                    paperEntryBar := bar_index
                    paperEntryTime := time
                    paperFilledAtOpen := true
                    paperActiveEntryMode := paperPendingEntryMode
                    paperBeArmed := false
                    paperInLong := paperSide == 1
                    paperInShort := paperSide == -1
                    paperInPrice := fill
            paperPendingSide := 0
            paperPendingAtr := na
            paperPendingLimit := na
            paperPendingExpiryBar := na
        else if paperPendingEntryMode == "LIMIT_PULLBACK"
            bool bullPend = paperPendingSide == 1
            bool touched = bullPend ? low <= paperPendingLimit : high >= paperPendingLimit
            if touched
                bool fillAtOpen = bullPend ? open <= paperPendingLimit : open >= paperPendingLimit
                float rawFill = bullPend ? math.min(open, paperPendingLimit) : math.max(open, paperPendingLimit)
                float fill = adverseFill(rawFill, paperPendingSide, true, paperSlippagePct)
                [ok, s, t, d] = resolvePaperLevels(paperPendingSide, fill, paperPendingAtr, effStopAtr, effMinStopPct, effRewardRisk)
                if ok
                    paperSide := paperPendingSide
                    paperEntry := fill
                    paperStop := s
                    paperInitialStop := s
                    paperTarget := t
                    paperInitialDist := d
                    paperEntryBar := bar_index
                    paperEntryTime := time
                    paperFilledAtOpen := fillAtOpen
                    paperActiveEntryMode := paperPendingEntryMode
                    paperBeArmed := false
                    paperInLong := paperSide == 1
                    paperInShort := paperSide == -1
                    paperInPrice := fill
                paperPendingSide := 0
                paperPendingAtr := na
                paperPendingLimit := na
                paperPendingExpiryBar := na
            else if bar_index >= paperPendingExpiryBar
                expiredSide := paperPendingSide
                paperPendingSide := 0
                paperPendingAtr := na
                paperPendingLimit := na
                paperPendingExpiryBar := na

    if paperSide != 0
        [exitRaw, exitReason] = paperExitConservative(paperSide, paperActiveEntryMode, bar_index == paperEntryBar, paperFilledAtOpen, paperBeArmed, open, high, low, close, paperStop, paperTarget, bar_index - paperEntryBar + 1, effMaxHoldBars)
        if exitReason != 0
            exitedSide := paperSide
            exitedReason := exitReason
            paperOutPrice := adverseFill(exitRaw, paperSide, false, paperSlippagePct)
            paperClosedNet := paperSide * (paperOutPrice - paperEntry) / paperEntry * 100.0 - paperFeePct
            paperClosedNet := math.abs(paperClosedNet) < EPS_ZERO ? 0.0 : paperClosedNet
            paperOutReason := exitReason
            paperClosedSide := paperSide
            paperClosedEntry := paperEntry
            if paperClosedNet > EPS_ZERO
                paperWins += 1
                paperGains += paperClosedNet
            else if paperClosedNet < -EPS_ZERO
                paperLosses += 1
                paperLossSum -= paperClosedNet
            else
                paperTies += 1
            paperTotalNet += paperClosedNet
            paperHistory.unshift(paperVisual.new(side = paperSide, xStart = paperEntryTime, xEnd = time, entryPrice = paperEntry, stopPrice = paperStop, initialStop = paperInitialStop, targetPrice = paperTarget, beArmed = paperBeArmed, outReason = exitReason))
            if paperHistory.size() > MAX_PAPER_VISUALS
                paperHistory.pop()
            paperSide := 0

    if paperSide != 0 and effBeTriggerR > 0 and not paperBeArmed
        if paperSide * (close - paperEntry) >= effBeTriggerR * paperInitialDist
            float raisedStop = paperEntry * (1.0 + paperSide * effBeOffsetPct / 100.0)
            if paperSide * (raisedStop - paperStop) > 0 and paperSide * (paperTarget - raisedStop) > 0
                paperStop := raisedStop
                paperBeArmed := true

    if paperSide != 0
        if paperSide == 1
            strategy.exit("Exit L", from_entry = "L", stop = paperStop, limit = paperTarget)
        else
            strategy.exit("Exit S", from_entry = "S", stop = paperStop, limit = paperTarget)

    if paperSide == 0 and paperPendingSide == 0 and candSide != 0 and bar_index >= 250 and cooldownGate(true, lastPaperSignal, bar_index, effCooldown)
        float refEntry = effEntryMode == "LIMIT_PULLBACK" ? candLimit : close
        [preOk, preStop, preTarget, _pd] = resolvePaperLevels(candSide, refEntry, qualityAtr, effStopAtr, effMinStopPct, effRewardRisk)
        if preOk
            queuedSide := candSide
            paperPendingSide := candSide
            paperPendingAtr := qualityAtr
            paperPendingLimit := effEntryMode == "LIMIT_PULLBACK" ? candLimit : na
            paperPendingEntryMode := effEntryMode
            paperSignalBar := bar_index
            paperPendingExpiryBar := bar_index + effExpiryBars
            paperSignalTime := time
            lastPaperSignal := bar_index
            if candSide == 1
                lastEmittedBuy := bar_index
                if effEntryMode == "LIMIT_PULLBACK"
                    strategy.entry("L", strategy.long, limit = paperPendingLimit)
                    // Omit limit = preTarget on the signal bar so non-gap fill-bar wicks cannot trigger premature TP before close.
                    strategy.exit("Exit L", from_entry = "L", stop = preStop)
                else
                    strategy.entry("L", strategy.long)
                    strategy.exit("Exit L", from_entry = "L", stop = preStop, limit = preTarget)
            else
                lastEmittedSell := bar_index
                if effEntryMode == "LIMIT_PULLBACK"
                    strategy.entry("S", strategy.short, limit = paperPendingLimit)
                    strategy.exit("Exit S", from_entry = "S", stop = preStop)
                else
                    strategy.entry("S", strategy.short)
                    strategy.exit("Exit S", from_entry = "S", stop = preStop, limit = preTarget)

    if expiredSide == 1 and queuedSide != 1
        strategy.cancel("L")
    if expiredSide == -1 and queuedSide != -1
        strategy.cancel("S")

    if exitedSide != 0 and strategy.position_size != 0
        string exComment = exitedReason == 3 ? "TIME" : exitedReason == 4 ? "BE+" : exitedReason == 2 ? "TP" : "SL"
        if exitedSide == 1 and strategy.position_size > 0
            strategy.close("L", comment = exComment)
        else if exitedSide == -1 and strategy.position_size < 0
            strategy.close("S", comment = exComment)

if qualifiedBuyArrow and not useChochMode and not useV3Mode and bullCandidate >= 0
    chosen = bullOBs.get(bullCandidate)
    chosen.signaled := true
if qualifiedSellArrow and not useChochMode and not useV3Mode and bearCandidate >= 0
    chosen = bearOBs.get(bearCandidate)
    chosen.signaled := true

if barstate.islast and showPaperLines and chart.is_standard
    if paperSide == 0 and paperPendingSide != 0 and paperPendingEntryMode == "LIMIT_PULLBACK" and not na(paperPendingLimit)
        int barsLeft = math.max(0, paperPendingExpiryBar - bar_index)
        color pendCol = paperPendingSide == 1 ? #2196f3 : #ff9800
        bin.ln.unshift(line.new(x1 = paperSignalTime, x2 = time, y1 = paperPendingLimit, y2 = paperPendingLimit, xloc = xloc.bar_time, color = pendCol, style = line.style_dotted, width = 2))
        bin.lb.unshift(label.new(x = time, y = paperPendingLimit, xloc = xloc.bar_time, text = (paperPendingSide == 1 ? "LMT L " : "LMT S ") + str.tostring(paperPendingLimit, format.mintick) + " (" + str.tostring(barsLeft) + "b)", color = color.new(pendCol, 85), textcolor = pendCol, style = label.style_label_left, size = size.tiny))
    if paperSide != 0
        color slCol = paperBeArmed ? #26a69a : #ff9800
        string slPrefix = paperBeArmed ? "BE+ " : "SL "
        bin.ln.unshift(line.new(x1 = paperEntryTime, x2 = time, y1 = paperStop, y2 = paperStop, xloc = xloc.bar_time, extend = extend.right, color = slCol, style = line.style_dashed, width = 2))
        bin.ln.unshift(line.new(x1 = paperEntryTime, x2 = time, y1 = paperTarget, y2 = paperTarget, xloc = xloc.bar_time, extend = extend.right, color = color.aqua, style = line.style_dashed, width = 2))
        bin.lb.unshift(label.new(x = time, y = paperStop, xloc = xloc.bar_time, text = slPrefix + str.tostring(paperStop, format.mintick), color = color.new(slCol, 85), textcolor = slCol, style = label.style_label_left, size = size.tiny))
        bin.lb.unshift(label.new(x = time, y = paperTarget, xloc = xloc.bar_time, text = "TP " + str.tostring(paperTarget, format.mintick), color = color.new(color.aqua, 85), textcolor = color.aqua, style = label.style_label_left, size = size.tiny))
    if paperHistory.size() > 0
        for item in paperHistory
            color histSlCol = item.beArmed ? #26a69a : #ff9800
            bin.ln.unshift(line.new(x1 = item.xStart, x2 = item.xEnd, y1 = item.stopPrice, y2 = item.stopPrice, xloc = xloc.bar_time, color = color.new(histSlCol, 35), style = line.style_dotted))
            bin.ln.unshift(line.new(x1 = item.xStart, x2 = item.xEnd, y1 = item.targetPrice, y2 = item.targetPrice, xloc = xloc.bar_time, color = color.new(color.aqua, 35), style = line.style_dotted))

int paperClosedCount = paperWins + paperLosses + paperTies
float paperPF = paperLossSum > 0 ? paperGains / paperLossSum : na
var table winLoss = table.new(position.top_right, 1, 1, bgcolor = color.new(color.black, 25))
if barstate.islast
    if showTradeStats
        string winText = paperClosedCount > 0 ? str.tostring(paperWins * 100.0 / paperClosedCount, "0.0") + "% (" + str.tostring(paperWins) + ")" : "N/A"
        string lossText = paperClosedCount > 0 ? str.tostring(paperLosses * 100.0 / paperClosedCount, "0.0") + "% (" + str.tostring(paperLosses) + ")" : "N/A"
        string pfText = paperClosedCount > 0 ? (not na(paperPF) ? str.tostring(paperPF, "0.00") : "∞") : "N/A"
        string netSign = paperTotalNet >= 0 ? "+" : ""
        string netText = paperClosedCount > 0 ? netSign + str.tostring(paperTotalNet, "0.00") + "%" : "N/A"
        string boardText = "Thắng " + winText + " | Thua " + lossText + (paperTies > 0 ? " | Hòa " + str.tostring(paperTies) : "") + " | N=" + str.tostring(paperClosedCount) + " | PF=" + pfText + " | Net " + netText
        table.cell(winLoss, 0, 0, boardText, text_color = color.white, text_size = size.small)
    else
        table.clear(winLoss, 0, 0, 0, 0)

plotshape(showSignals and paperInLong, title = "Paper IN LONG", style = shape.triangleup, location = location.belowbar, color = #089981, text = "IN L", textcolor = #089981, size = size.small)
plotshape(showSignals and paperInShort, title = "Paper IN SHORT", style = shape.triangledown, location = location.abovebar, color = #f23645, text = "IN S", textcolor = #f23645, size = size.small)
plotshape(showSignals and paperOutReason == 2 ? paperOutPrice : na, title = "Paper OUT TP", style = shape.xcross, location = location.absolute, color = color.aqua, text = "OUT TP", textcolor = color.aqua, size = size.tiny)
plotshape(showSignals and paperOutReason == 4 ? paperOutPrice : na, title = "Paper OUT BE", style = shape.xcross, location = location.absolute, color = #26a69a, text = "OUT BE", textcolor = #26a69a, size = size.tiny)
plotshape(showSignals and paperOutReason == 1 ? paperOutPrice : na, title = "Paper OUT SL", style = shape.xcross, location = location.absolute, color = color.orange, text = "OUT SL", textcolor = color.orange, size = size.tiny)
plotshape(showSignals and paperOutReason == 3 ? paperOutPrice : na, title = "Paper OUT TIME", style = shape.xcross, location = location.absolute, color = color.silver, text = "OUT T", textcolor = color.silver, size = size.tiny)

plot(paperInPrice, "Paper entry price", display = display.data_window)
plot(paperOutPrice, "Paper exit price", display = display.data_window)
plot(paperClosedNet, "Paper closed net (%)", display = display.data_window)

plot(is15mProfile ? v3_15m_side : v3_1h_rawSide, "Audit: raw signal side", display = display.none)
plot(candSide, "Audit: trade candidate", display = display.none)
plot(candLimit, "Audit: signal limit price", display = display.none)
plot(qualityAtr, "Audit: trade ATR14", display = display.none)
plot(paperPendingSide, "Audit: paper pending side", display = display.none)
plot(paperSide, "Audit: paper position side", display = display.none)
plot(paperStop, "Audit: paper active stop", display = display.none)
plot(paperTarget, "Audit: paper active target", display = display.none)
plot(paperBeArmed ? 1 : 0, "Audit: paper BE armed", display = display.none)
plot(paperOutReason, "Audit: paper exit reason", display = display.none)
plot(paperClosedSide, "Audit: paper closed side", display = display.none)
plot(paperOutReason != 0 ? paperClosedEntry : na, "Audit: paper closed entry price", display = display.none)
plot(paperWins, "Audit: paper wins", display = display.none)
plot(paperLosses, "Audit: paper losses", display = display.none)
plot(paperTies, "Audit: paper ties", display = display.none)
plot(paperPF, "Audit: paper profit factor", display = display.none)
plot(paperTotalNet, "Audit: paper total net percent", display = display.none)
