//@version=6
// Companion TradingView Strategy Tester script for SMC Confirmed [3.0.0].
// Matches TOOL.pine signal engines, causal HTF latching, Limit Pullback,
// conservative SL/TP, and confirmed-close BE+ ratchet 100%.
// Cost calibration: commission_value = 0.075% per side = 0.15% round-trip
// (0.10% round-trip fee + 2 x 0.025% adverse slippage per fill across any symbol).
strategy("BigBeluga - SMC High-WinRate Strategy", "SMC High-WinRate Strategy [3.0.0]",
     overlay = true,
     initial_capital = 10000,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 100,
     commission_type = strategy.commission.percent,
     commission_value = 0.075,
     slippage = 0,
     pyramiding = 0,
     calc_on_every_tick = false,
     process_orders_on_close = false,
     max_bars_back = 5000,
     max_boxes_count = 500,
     max_labels_count = 500,
     max_lines_count = 500,
     max_polylines_count = 100)

plot(na)

