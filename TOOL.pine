indicator("BigBeluga - Smart Money Concepts", "SMC Confirmed [1.3.0]",
     overlay = true,
     max_bars_back = 5000,
     max_boxes_count = 500,
     max_labels_count = 500,
     max_lines_count = 500,
     max_polylines_count = 100)

plot(na)

const int HISTORY_LIMIT = 4500
const int MAX_ZONES = 100
const int MAX_MAPPING_POINTS = 1000

//
MSG = "MARKET STRUCTURE"
VBG = "ORDER BLOCKS"
MST = "Limit displayed structure to recent bars. Calculations use bounded history and confirmed candles."
SLT = "Maximum retained structures per direction"
CST = "Color candle based on trend detection system"
OBD = "Show Last number of orderblock"
OBMT = "[Length] Use Length to adjust cordinate of the orderblocks\n[Full] Use the full high-low range of the source candle"
// Section
bool windowsis      = input.bool(true, "Window", inline="kla", group=MSG)
int mswindow        = input.int(4500, "", tooltip=MST,group=MSG, inline="kla", minval=1000, maxval=4500)

bool showSwing      = input.bool(true, "Swing", inline="scss", group=MSG)
int swingLimit      = input.int(100, "", tooltip=SLT, inline="scss", group=MSG, minval=10, maxval=100)

color swingcssup    = input.color(#089981, "", inline="scss", group=MSG)
color swingcssdn    = input.color(#f23645, "", inline="scss", group=MSG)


bool showMapping    = input.bool(false, "Mapping Structure", inline="mapping", group=MSG)
string mappingStyle = input.string("----", "", options=["⎯⎯⎯⎯", "----"], inline="mapping", group=MSG)
color mappingcss    = input.color(color.silver, "", tooltip="Display Mapping Structure", inline="mapping", group=MSG)
bool candlecss      = input.bool(false, "Color Candles", tooltip=CST, group=MSG, inline="txt")
string mstext       = input.string("Tiny", "", options=["Tiny", "Small", "Normal", "Large", "Huge"],
 inline="txt", group=MSG)
string msmode       = input.string("Adjusted Points", "Algorithmic Logic", options=["Extreme Points", "Adjusted Points"]
 , inline="node", group=MSG)

int mslen           = input.int(5, "", inline="node", group=MSG, minval=2, maxval=100, tooltip="Pivot confirmation needs this many closed candles on the right.")
bool buildsweep     = input.bool(true, "Build Sweep (x)", "Build sweep on market structure", "znc", MSG)
bool msbubble       = input.bool(true, "Bubbles", tooltip="Display Circle Bubbles", inline="bubbles", group=MSG)

bool obshow         = input.bool(true, "Show Last", tooltip=OBD, group=VBG, inline="obshow")
int oblast          = input.int(5, "", group=VBG, inline="obshow", minval=0, maxval=20)
color obupcs       = input.color(color.new(#089981, 90), "", inline="obshow", group=VBG)
color obdncs       = input.color(color.new(#f23645, 90), "", inline="obshow", group=VBG)
obshowbb     = input.bool(false, "Show Breakers", inline="bb", group=VBG, tooltip="Display Breakers")
color bbup         = input.color(color.new(#089981, 100), "", inline="bb", group=VBG)
color bbdn         = input.color(color.new(#f23645, 100), "", inline="bb", group=VBG)
obmode       = input.string("Length", "Construction", options=["Length", "Full"], tooltip=OBMT, inline="atr", group=VBG)
len          = input.int(5, "", inline="atr", group=VBG, minval=1)
obmiti       = input.string("Close", "Mitigation Method", options=["Close", "Wick", "Avg"],
 tooltip="Mitigation method for when to trigger order blocks", group=VBG)
obtxt        = input.string("Normal", "Metric Size", options=["Tiny", "Small", "Normal", "Large", "Huge", "Auto"],
 tooltip="Order block Metrics text size", inline="obtxt", group=VBG)
showmetric   = input.bool(true, "Source candle volume", tooltip="Volume of the source candle only; not buy/sell volume or a probability. Unavailable volume is shown as N/A.", group=VBG)
showline     = input.bool(true, "Show Mid-Line", group=VBG)
overlap      = input.bool(true, "Hide Overlap", group=VBG, inline="ov")
wichlap      = input.string("Recent", "", options=["Recent", "Old"], inline="ov", group=VBG, tooltip="Keep the more recent or older confirmed zone when zones overlap.")

fvg_enable   = input.bool(false, "Enable FVG", inline="1", group="FAIR VALUE GAP", tooltip="Confirm gaps at candle close and draw them from their detection candle")
what_fvg     = input.string("FVG", "", inline="1", group="FAIR VALUE GAP", tooltip="Display fair value gap",
 options=["FVG", "Breakers"])
fvg_num      = input.int(5, "Show Last", inline="1a", group="FAIR VALUE GAP", tooltip="Confirmed gaps, drawn from the detection candle", minval=0, maxval=20)
fvg_upcss    = input.color(color.new(#089981, 80), "", inline="1", group="FAIR VALUE GAP")
fvg_dncss    = input.color(color.new(#f23645, 80), "", inline="1", group="FAIR VALUE GAP")
fvgbbup      = input.color(color.new(#089981, 100), "", inline="1", group="FAIR VALUE GAP")
fvgbbdn      = input.color(color.new(#f23645, 100), "", inline="1", group="FAIR VALUE GAP")
fvg_src      = input.string("Close", "Mitigation",
 inline="3",
 group="FAIR VALUE GAP",
 tooltip="[Close] Invalidate only beyond the boundary at candle close\n\n[Wick] Use the high or low of the confirmed candle",
 options=["Close", "Wick", "Avg"])
fvgthresh    = input.float(0, "Threshold", tooltip="Filter out non significative FVG", group="FAIR VALUE GAP",
 inline="asd", minval=0, maxval=2, step=0.1)
fvgoverlap   = input.bool(true, "Hide Overlap", "Hide overlapping FVG", group="FAIR VALUE GAP")
fvgline      = input.bool(true, "Show Mid-Line", group="FAIR VALUE GAP")
fvgextend    = input.bool(false, "Extend FVG", group="FAIR VALUE GAP")
dispraid     = input.bool(false, "Display Raids", inline="raid", group="FAIR VALUE GAP")


//}
// Section


// Closed-candle directional opportunities; thresholds are heuristics, not probabilities.
SIG = "CONFIRMED ARROWS"
showSignals = input.bool(true, "Show buy/sell arrows", group = SIG)
signalUseMapping = input.bool(true, "Use Mapping agreement", group = SIG)
signalUseFVG = input.bool(true, "Use overlapping FVG", group = SIG, tooltip = "The candle must reject the common price area of an older active OB and a same-direction FVG. FVG calculation works even when its drawing is hidden.")
signalUseSweep = input.bool(true, "Use recent sweep or FVG raid", group = SIG)
signalSweepBars = input.int(10, "Sweep/raid lookback", minval = 1, maxval = 100, group = SIG)
signalUseVolume = input.bool(true, "Use confirmation volume", group = SIG)
signalVolLength = input.int(20, "Volume baseline candles", minval = 2, maxval = 200, group = SIG, tooltip = "Baseline excludes the candle being measured. Missing or zero baseline blocks volume-filtered signals.")
signalVolumeMin = input.float(1.2, "Minimum confirmation RVOL", minval = 0.1, step = 0.1, group = SIG)
signalUseSourceVolume = input.bool(true, "Use OB source relative volume", group = SIG)
signalSourceMin = input.float(1.0, "Minimum source RVOL", minval = 0.1, step = 0.1, group = SIG)

signalMode = input.string("Balanced", "Signal mode", options = ["Balanced", "Strict"], group = SIG, tooltip = "Balanced requires the selected minimum number of supporting checks. Strict requires every enabled check. Structure and an older active OB rejection are mandatory in both modes. Scores are not probabilities.")
signalMinEvidence = input.int(2, "Balanced: minimum supporting checks", minval = 1, maxval = 5, group = SIG)
showSignalStatus = input.bool(true, "Show signal status", group = SIG)

type store
    line    [] ln
    label   [] lb
    box     [] bx
    linefill[] lf

type structure
    int    zn
    float  zz
    float  bos
    float  choch
    int    loc
    int    temp
    int    trend
    int    start
    float  main
    int    xloc
    bool   upsweep
    bool   dnsweep
    string txt = na

type drawms
    int    x1
    int    x2
    float  y
    string txt
    color  css
    string style

type ob
    bool  bull
    float top
    float btm
    float avg
    int   loc
    color css
    float vol
    float sourceRvol = na
    bool  signaled = false
    bool  isbb = false
    int   bbloc

type FVG
    float top     = na
    float btm     = na
    int   loc     = bar_index
    bool  isbb    = false
    int   bbloc   = na
    bool  israid  = false
    float raidy   = na
    int   raidloc = na
    int   raidx2  = na
    bool  active  = false
    color raidcs  = na

//}
// Section

var store bin = store.new(
                   array.new<  line  >()
                 , array.new<  label >()
                 , array.new<   box  >()
                 , array.new<linefill>()
                 )


if barstate.islast
    for obj in bin.ln
        obj.delete()
    for obj in bin.lb
        obj.delete()
    for obj in bin.bx
        obj.delete()
    for obj in bin.lf
        obj.delete()

    bin.ln.clear()
    bin.lb.clear()
    bin.bx.clear()
    bin.lf.clear()


invcol = #ffffff00


float     atr =              (ta.atr(200) / (5/len))

//}
// Section

method txSz(string s) =>
    out = switch s
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        "Huge"   => size.huge
        "Auto"   => size.auto
    out


method lstyle(string style) =>
    out = switch style
        '⎯⎯⎯⎯'  => line.style_solid
        '----'  => line.style_dashed
        '····'  => line.style_dotted


ghl() => [high[2], low[2], close[1], open[1], close, open, high, low, high[1], low[1], ta.atr(200)]


float signalVolumeBase = ta.sma(volume, signalVolLength)[1]

historyOffset(int loc) =>
    math.min(math.max(bar_index - nz(loc, bar_index), 0), math.min(bar_index, HISTORY_LIMIT))

method IDMIDX(bool use_max, int loc) =>
    int idx = 0
    float extreme = na
    for i = 0 to historyOffset(loc)
        float value = use_max ? high[i] : low[i]
        if not na(value) and (na(extreme) or (use_max ? value >= extreme : value <= extreme))
            extreme := value
            idx := i
    idx

method find(structure ms, bool use_max, bool sweep, bool useob) =>
    int span = historyOffset(sweep ? ms.xloc : ms.loc)
    int last = span > 1 ? span - 1 : span
    int idx = 0
    float extreme = na
    for i = 0 to last
        float value = use_max ? high[i] : low[i]
        if not na(value) and (na(extreme) or (use_max ? value >= extreme : value <= extreme))
            extreme := value
            idx := i
    if useob and idx < math.min(bar_index, HISTORY_LIMIT)
        if use_max ? high[idx + 1] > high[idx] : low[idx + 1] < low[idx]
            idx += 1
    idx

relativeVolume(float measured, float baseline) =>
    not na(measured) and not na(baseline) and baseline > 0 ? measured / baseline : na

method fnOB(ob[] block, bool bull, float cords, int idx, float sourceRvol) =>
    float top = bull ? cords : high[idx]
    float bottom = bull ? low[idx] : cords
    // ATR is unavailable during warm-up; do not create an invalid price zone.
    if not na(top) and not na(bottom) and top > bottom
        block.unshift(ob.new(bull = bull, top = top, btm = bottom, avg = math.avg(top, bottom), loc = time, css = bull ? obupcs : obdncs, vol = volume[idx], sourceRvol = sourceRvol))
        if block.size() > MAX_ZONES
            block.pop()

zonesOverlap(float topA, float bottomA, float topB, float bottomB) =>
    math.min(topA, topB) > math.max(bottomA, bottomB)

recentEvent(int eventBar, int currentBar, int lookback) =>
    not na(eventBar) and currentBar >= eventBar and currentBar - eventBar <= lookback

zoneRejection(ob zone, int direction, int candleTime, float candleHigh, float candleLow, float candleClose) =>
    bool bull = direction == 1
    zone.bull == bull and not zone.isbb and not zone.signaled and zone.loc < candleTime and candleHigh >= zone.btm and candleLow <= zone.top and (bull ? candleClose > zone.top : candleClose < zone.btm)

gapConfirmation(FVG[] gaps, ob zone, int direction, int candleTime, float candleHigh, float candleLow, float candleClose) =>
    bool confirmed = false
    for gap in gaps
        if not gap.isbb and gap.loc < candleTime and zonesOverlap(zone.top, zone.btm, gap.top, gap.btm)
            bool touched = candleLow <= math.min(zone.top, gap.top) and candleHigh >= math.max(zone.btm, gap.btm)
            bool rejected = direction == 1 ? candleClose > math.max(zone.top, gap.top) : candleClose < math.min(zone.btm, gap.btm)
            if touched and rejected
                confirmed := true
                break
    confirmed

signalEvidence(int direction, int mappingTrend, bool gapOK, bool sweepOK, float confirmationRvol, float sourceRvol) =>
    int enabled = (signalUseMapping ? 1 : 0) + (signalUseFVG ? 1 : 0) + (signalUseSweep ? 1 : 0) + (signalUseVolume ? 1 : 0) + (signalUseSourceVolume ? 1 : 0)
    int score = (signalUseMapping and mappingTrend == direction ? 1 : 0) + (signalUseFVG and gapOK ? 1 : 0) + (signalUseSweep and sweepOK ? 1 : 0) + (signalUseVolume and not na(confirmationRvol) and confirmationRvol >= signalVolumeMin ? 1 : 0) + (signalUseSourceVolume and not na(sourceRvol) and sourceRvol >= signalSourceMin ? 1 : 0)
    bool available = (not signalUseVolume or not na(confirmationRvol)) and (not signalUseSourceVolume or not na(sourceRvol))
    [score, enabled, available]

evidenceDecision(string mode, int minimum, int score, int enabled, bool available) =>
    available and score >= (mode == "Strict" ? enabled : math.min(minimum, enabled))

signalAgreement(int direction, int structureTrend, int mappingTrend, bool gapOK, bool sweepOK, float confirmationRvol, float sourceRvol) =>
    [score, enabled, available] = signalEvidence(direction, mappingTrend, gapOK, sweepOK, confirmationRvol, sourceRvol)
    structureTrend == direction and evidenceDecision(signalMode, signalMinEvidence, score, enabled, available)

resolveSignals(bool confirmed, int bullIndex, int bearIndex) =>
    [confirmed and bullIndex >= 0 and bearIndex < 0, confirmed and bearIndex >= 0 and bullIndex < 0]

signalCandidate(ob[] zones, FVG[] gaps, int direction, int structureTrend, int mappingTrend, bool sweepOK, float confirmationRvol) =>
    int found = -1
    if barstate.isconfirmed and structureTrend == direction and zones.size() > 0
        for i = 0 to zones.size() - 1
            zone = zones.get(i)
            if zoneRejection(zone, direction, time, high, low, close)
                bool gapOK = not signalUseFVG or gapConfirmation(gaps, zone, direction, time, high, low, close)
                if signalAgreement(direction, structureTrend, mappingTrend, gapOK, sweepOK, confirmationRvol, zone.sourceRvol)
                    found := i
                    break
    found

signalProgress(ob[] zones, FVG[] gaps, int direction, int mappingTrend, bool sweepOK, float confirmationRvol) =>
    int best = -1
    bool dataOK = false
    for zone in zones
        if zoneRejection(zone, direction, time, high, low, close)
            bool gapOK = gapConfirmation(gaps, zone, direction, time, high, low, close)
            [score, enabled, available] = signalEvidence(direction, mappingTrend, gapOK, sweepOK, confirmationRvol, zone.sourceRvol)
            if score > best or (score == best and available)
                best := score
                dataOK := available
    [best, dataOK]

preferFirst(int firstTime, int secondTime, string policy) =>
    policy == "Recent" ? firstTime >= secondTime : firstTime <= secondTime

mitigationHit(bool below, float boundary, string mode, float midpoint) =>
    float price = mode == "Close" ? close : below ? low : high
    float level = mode == "Avg" ? midpoint : boundary
    below ? price < level : price > level

method mitigated(ob[] block) =>
    if barstate.isconfirmed and block.size() > 0
        for i = block.size() - 1 to 0
            stuff = block.get(i)
            bool below = stuff.bull != stuff.isbb
            if mitigationHit(below, below ? stuff.btm : stuff.top, obmiti, stuff.avg)
                if stuff.isbb or not obshowbb
                    block.remove(i)
                else
                    stuff.isbb := true
                    stuff.bbloc := time
    true

overlap(ob[] bull, ob[] bear) =>
    // Resolve actual pairs. Removing index 0 for a different pair loses valid zones.
    for side = 0 to 1
        zones = side == 0 ? bull : bear
        int i = 0
        while i < zones.size()
            int j = i + 1
            bool removed = false
            while j < zones.size() and not removed
                first = zones.get(i)
                other = zones.get(j)
                if zonesOverlap(first.top, first.btm, other.top, other.btm)
                    if preferFirst(first.loc, other.loc, wichlap)
                        zones.remove(j)
                    else
                        zones.remove(i)
                        removed := true
                else
                    j += 1
            if not removed
                i += 1
    int i = 0
    while i < bull.size()
        int j = 0
        bool removed = false
        while j < bear.size() and not removed
            first = bull.get(i)
            other = bear.get(j)
            if zonesOverlap(first.top, first.btm, other.top, other.btm)
                if preferFirst(first.loc, other.loc, wichlap)
                    bear.remove(j)
                else
                    bull.remove(i)
                    removed := true
            else
                j += 1
        if not removed
            i += 1

overlapFVG(FVG[] blFVG, FVG[] brFVG) =>
    for side = 0 to 1
        zones = side == 0 ? blFVG : brFVG
        int i = 0
        while i < zones.size()
            int j = i + 1
            bool removed = false
            while j < zones.size() and not removed
                first = zones.get(i)
                other = zones.get(j)
                if zonesOverlap(first.top, first.btm, other.top, other.btm)
                    if first.loc >= other.loc
                        zones.remove(j)
                    else
                        zones.remove(i)
                        removed := true
                else
                    j += 1
            if not removed
                i += 1
    int i = 0
    while i < blFVG.size()
        int j = 0
        bool removed = false
        while j < brFVG.size() and not removed
            first = blFVG.get(i)
            other = brFVG.get(j)
            if zonesOverlap(first.top, first.btm, other.top, other.btm)
                if first.loc >= other.loc
                    brFVG.remove(j)
                else
                    blFVG.remove(i)
                    removed := true
            else
                j += 1
        if not removed
            i += 1

method mitigateFVG(FVG[] zones, bool bull) =>
    if barstate.isconfirmed and zones.size() > 0
        for i = zones.size() - 1 to 0
            gap = zones.get(i)
            bool below = bull != gap.isbb
            if mitigationHit(below, below ? gap.btm : gap.top, fvg_src, math.avg(gap.top, gap.btm))
                if gap.isbb or what_fvg == "FVG"
                    zones.remove(i)
                else
                    gap.isbb := true
                    gap.bbloc := time
    true

method display(ob id, ob[] full, int i) =>
    if not id.isbb
        bin.bx.unshift(box.new    (top = id.top, bottom = id.btm, left = id.loc, right    = time      , border_color = na    , bgcolor = id.css, xloc = xloc.bar_time))
        bin.bx.unshift(box.new    (top = id.top, bottom = id.btm, left = time   , right   = time + 1  , border_color = na    , bgcolor = id.css, xloc = xloc.bar_time, extend = extend.right))

    else
        bin.bx.unshift(box.new    (top = id.top, bottom = id.btm, left = id.loc   , right = id.bbloc , border_color = na     , bgcolor = id.css                , xloc = xloc.bar_time))
        bin.bx.unshift(box.new    (top = id.top, bottom = id.btm, left = id.bbloc , right = time     , border_color = id.css , bgcolor = id.bull ? bbup : bbdn , xloc = xloc.bar_time, border_width = 2))
        bin.bx.unshift(box.new    (top = id.top, bottom = id.btm, left = time     , right = time + 1 , border_color = id.css , bgcolor = id.bull ? bbup : bbdn , xloc = xloc.bar_time, extend = extend.right))

    if showline
        bin.ln.unshift(line.new(
               x1    = id.loc
             , x2    = time
             , y1    = id.avg
             , y2    = id.avg
             , color = color.new(id.css, 0)
             , xloc  = xloc.bar_time
             , style = line.style_dashed
              )
             )

    if showmetric
        string metricText = na(id.vol) ? "Source V: N/A" : "Source V: " + str.tostring(id.vol, format.volume)
        bin.lb.unshift(label.new(bar_index, id.avg, text = metricText, textcolor = color.new(id.css, 0), style = label.style_label_left, size = obtxt.txSz(), color = #ffffff00, tooltip = "Volume of the source candle. This is not measured buy/sell volume or a probability."))

method dispFVG(FVG fvg, int i, bool bull) =>
    ext = fvgextend ? extend.right : extend.none
    if not fvg.isbb
        bin.bx.unshift(box .new(top = fvg.top, bottom = fvg.btm, left = fvg.loc                 , right = time                   , border_color = na   , bgcolor = bull ? fvg_upcss : fvg_dncss            , xloc = xloc.bar_time, extend = ext))
        if fvgline
            bin.ln.unshift(line.new(x1  = fvg.loc, x2 = time       , y1 = math.avg(fvg.top, fvg.btm), y2 = math.avg(fvg.top, fvg.btm), xloc = xloc.bar_time, color = color.new(bull ? fvg_upcss : fvg_dncss, 0)                      , extend = ext))
        if dispraid
            bin.ln.unshift(line.new(x1  = fvg.raidloc, x2 = fvg.raidx2, y1 = fvg.raidy, y2 = fvg.raidy, xloc = xloc.bar_time, color = fvg.raidcs))
            bin.lb.unshift(label.new(x = int(math.avg(fvg.raidloc, fvg.raidx2)), y = fvg.raidy, text = "x", xloc = xloc.bar_time, textcolor = fvg.raidcs, style = bull ? label.style_label_up : label.style_label_down, size = size.small, color = #ffffff00))

    else
        bin.bx.unshift(box .new(top = fvg.top  , bottom = fvg.btm, left = fvg.loc                   , right = fvg.bbloc              , border_color = na                                 , bgcolor = bull ? fvg_upcss : fvg_dncss, xloc = xloc.bar_time))
        bin.bx.unshift(box .new(top = fvg.top  , bottom = fvg.btm, left = fvg.bbloc                 , right = time                   , border_color = bull ? fvg_dncss : fvg_upcss       , bgcolor = bull ? fvg_dncss : fvg_upcss, xloc = xloc.bar_time, extend = ext))
        if fvgline
            bin.ln.unshift(line.new(x1  = fvg.loc  , x2 = fvg.bbloc  , y1   = math.avg(fvg.top, fvg.btm), y2 = math.avg(fvg.top, fvg.btm), color = color.new(bull ? fvg_upcss : fvg_dncss, 0)                                        , xloc = xloc.bar_time))
            bin.ln.unshift(line.new(x1  = fvg.bbloc, x2 = time       , y1   = math.avg(fvg.top, fvg.btm), y2 = math.avg(fvg.top, fvg.btm), color = color.new(bull ? fvg_dncss : fvg_upcss, 0)                                        , xloc = xloc.bar_time, extend = ext, style = line.style_dashed))
//}
// Section

mapping(bool draw) =>
    var float    up          = na
    var float    dn          = na
    var float point          = na
    var int   trend          = 0
    var int     idx          = na
    var int     sum          = na
    var int project          = na
    var chart.point[] charts = array.new<chart.point>()

    if barstate.isconfirmed
        if na(up)
            up := high
            idx := bar_index

        if na(dn)
            dn := low
            idx := bar_index

        if high > up
            if trend == -1
                id = IDMIDX(false, idx)
                charts.unshift(
                     chart.point.from_time(
                           time[id]
                         , low [id]
                          )
                         )
                idx   := bar_index
                point := low [id]
                sum   := time[id]

            up      := high
            dn      := low
            project := time
            trend   := 1

        if low < dn
            if trend == 1
                id = IDMIDX(true, idx)
                charts.unshift(
                     chart.point.from_time(
                           time[id]
                         , high[id]
                          )
                         )
                idx   := bar_index
                point := high[id]
                sum   := time[id]

            up      := high
            dn      := low
            project := time
            trend := -1

        while charts.size() > MAX_MAPPING_POINTS
            charts.pop()

    if barstate.islast and draw
        var line     ln = na
        var polyline pl = na
        ln.delete()
        pl.delete()
        ln := na
        pl := na
        ln := line.new(
               x1 = sum
             , x2 = project
             , y1 = point
             , y2 = trend == 1 ? up : dn
             , xloc = xloc.bar_time
             , color = color.red
             )
        pl := polyline.new(
               charts
             , line_color = mappingcss
             , xloc = xloc.bar_time
             , line_style = mappingStyle.lstyle()
             )
    trend


dFVG() =>
    [h2, l2, c1, o1, c, o, h, l, h1, l1, fvatr] = ghl()
    var FVG[] blFVG = array.new<FVG>()
    var FVG[] brFVG = array.new<FVG>()
    var int lastBullRaid = na
    var int lastBearRaid = na
    bool      upfvg = false
    bool      dnfvg = false
    float     blth  = l1 + (fvatr[1] * fvgthresh)
    float     brth  = h1 - (fvatr[1] * fvgthresh)

    if barstate.isconfirmed
        upfvg := l > h2 and c1 > blth
        dnfvg := l2 > h and c1 < brth
        if upfvg
            blFVG.unshift(FVG.new(top = l, btm = h2, loc = time))
        if dnfvg
            brFVG.unshift(FVG.new(top = l2, btm = h, loc = time))
        if blFVG.size() > MAX_ZONES
            blFVG.pop()
        if brFVG.size() > MAX_ZONES
            brFVG.pop()
        blFVG.mitigateFVG(true)
        brFVG.mitigateFVG(false)
        if fvgoverlap and (upfvg or dnfvg)
            overlapFVG(blFVG, brFVG)

    if barstate.isconfirmed
        for [i, fvg] in blFVG
            if not fvg.israid and not fvg.isbb
                if low < fvg.top and close > fvg.top
                    fvg.israid  := true
                    fvg.raidloc := time
                    fvg.raidx2  := time
                    fvg.raidy   := low
                    fvg.raidcs  := chart.fg_color
                    lastBullRaid := bar_index
            else
                if low <= fvg.raidy and fvg.active == false and not fvg.isbb

                    fvg.active := true
                    fvg.raidx2 := time
                else
                    if fvg.active == false and not fvg.isbb
                        fvg.raidx2 := time

        for [i, fvg] in brFVG
            if not fvg.israid and not fvg.isbb
                if high > fvg.btm and close < fvg.btm and not fvg.isbb
                    fvg.israid  := true
                    fvg.raidloc := time
                    fvg.raidy   := high
                    fvg.raidx2  := time
                    fvg.raidcs  := chart.fg_color
                    lastBearRaid := bar_index
            else
                if high >= fvg.raidy and fvg.active == false and not fvg.isbb

                    fvg.active := true
                    fvg.raidx2 := time
                else
                    if fvg.active == false and not fvg.isbb
                        fvg.raidx2 := time


    if barstate.islast and fvg_enable
        if blFVG.size() > 0 and fvg_num > 0
            for i = 0 to math.min(fvg_num - 1, blFVG.size() - 1)
                fvg = blFVG.get(i)
                dispFVG(fvg, i, true)

        if brFVG.size() > 0 and fvg_num > 0
            for i = 0 to math.min(fvg_num - 1, brFVG.size() - 1)
                fvg = brFVG.get(i)
                dispFVG(fvg, i, false)
    [blFVG, brFVG, lastBullRaid, lastBearRaid]


structure(color upcss, color dncss, bool draw, bool internal, int limit) =>
    var structure ms  = structure.new(start = 0)
    var     ob     [] blob     = array.new<     ob    >()
    var     ob     [] brob     = array.new<     ob    >()
    var drawms     [] bldw     = array.new<  drawms   >()
    var drawms     [] brdw     = array.new<  drawms   >()
    bool      crossup =     false
    bool      crossdn =     false
    var float up      =     na
    var float dn      =     na
    idbull            =  ms.find(false, false, true)
    idbear            =  ms.find(true , false, true)
    float sourceBullRvol = relativeVolume(volume[idbull], signalVolumeBase[idbull])
    float sourceBearRvol = relativeVolume(volume[idbear], signalVolumeBase[idbear])
    btmP              =  obmode == "Length" ? (high[idbear] - 1 * atr[idbear]) < low [idbear] ? low [idbear] : (high[idbear] - 1 * atr[idbear]) : low [idbear]
    topP              =  obmode == "Length" ? (low [idbull] + 1 * atr[idbull]) > high[idbull] ? high[idbull] : (low [idbull] + 1 * atr[idbull]) : high[idbull]
    ph                = ta.pivothigh(high, mslen, mslen)
    pl                = ta.pivotlow (low , mslen, mslen)
    var int  [] phn   = array.new< int >()
    var int  [] pln   = array.new< int >()
    var float[] php   = array.new<float>()
    var float[] plp   = array.new<float>()

    if barstate.isconfirmed
        if internal
            blob.clear()
            brob.clear()

        if not na(ph)
            phn.clear()
            php.clear()
            phn.unshift(bar_index[mslen])
            php.unshift(high[mslen])

        if not na(pl)
            pln.clear()
            plp.clear()
            pln.unshift(bar_index[mslen])
            plp.unshift(low[mslen])

        if php.size() > 0
            if high > php.get(0)
                php.clear()
                phn.clear()

        if plp.size() > 0
            if low < plp.get(0)
                plp.clear()
                pln.clear()

        if na(up)
            up      := high

        if na(dn)
            dn      := low

        if high > up
            up      := high
            dn      := low
            crossup := true

        if low < dn
            up      := high
            dn      := low
            crossdn := true

        if ms.start == 0
            ms         := structure.new(bar_index, na, high, low , bar_index, bar_index, 0, 1, na, bar_index)
            if draw
                bldw.unshift(drawms.new(time, time, high     , "CHoCH"  , upcss, line.style_dashed))
                brdw.unshift(drawms.new(time, time, low      , "CHoCH"  , dncss, line.style_dashed))

        ms.upsweep := false
        ms.dnsweep := false

        if ms.start == 1
            switch
                low <= ms.choch and close >= ms.choch and buildsweep =>

                    ms.dnsweep   := true
                    ms.choch     := low
                    ms.xloc      := bar_index
                    if draw
                        dw        = brdw.get(0)
                        dw.x2    := time
                        dw.style := line.style_dotted
                        dw.txt   := "x"
                        brdw.unshift(
                             drawms.new(
                                   time
                                 , time
                                 , low
                                 , "CHoCH"
                                 , dncss
                                 , line.style_dashed
                                  )
                                 )


                high >= ms.bos and close <= ms.bos and buildsweep =>

                    ms.upsweep   := true
                    ms.bos       := high
                    ms.xloc      := bar_index
                    if draw
                        dw        = bldw.get(0)
                        dw.x2    := time
                        dw.style := line.style_dotted
                        dw.txt   := "x"
                        bldw.unshift(
                             drawms.new(
                                   time
                                 , time
                                 , high
                                 , "CHoCH"
                                 , upcss
                                 , line.style_dashed
                                  )
                                 )


                close <= ms.choch =>

                    ms.txt       := "choch"
                    brob.fnOB(false, btmP, idbear, sourceBearRvol)
                    ms.trend     := -1
                    ms.choch     := ms.bos
                    ms.bos       := na
                    ms.start     := 2
                    ms.loc       := bar_index
                    ms.main      := low
                    ms.temp      := ms.loc
                    ms.xloc      := bar_index
                    if draw
                        dw        = brdw.get(0)
                        dw.x2    := time
                        dw.style := internal ? line.style_dashed : line.style_solid


                close >= ms.bos =>

                    ms.txt       := "choch"
                    blob.fnOB(true, topP, idbull, sourceBullRvol)
                    ms.trend     := 1
                    ms.choch     := ms.choch
                    ms.bos       := na
                    ms.start     := 2
                    ms.loc       := bar_index
                    ms.main      := high
                    ms.temp      := ms.loc
                    ms.xloc      := bar_index
                    if draw
                        dw        = bldw.get(0)
                        dw.x2    := time
                        dw.style := internal ? line.style_dashed : line.style_solid


        if ms.start == 2
            switch ms.trend
                -1 =>
                    if low <= ms.main
                        ms.main     := low
                        ms.temp     := bar_index

                    if bar_index % mslen * 2 == 0
                        if not na(ms.bos) and msmode == "Adjusted Points" and php.size() > 0
                            if php.get(0) < ms.choch
                                // ms.xloc  := phn.get(0)
                                ms.choch := php.get(0)
                                ms.loc   := phn.get(0)
                                ms.xloc  := phn.get(0)
                                ms.temp  := phn.get(0)
                                if draw
                                    choch     = bldw.get(0)
                                    choch.x1 := time [historyOffset(phn.get(0))]
                                    choch.x2 := time
                                    choch.y  := php.get(0)

                    if na(ms.bos)
                        if crossup and close > open and close[1] > open[1]
                            ms.bos  := ms.main
                            ms.loc  := ms.temp
                            ms.xloc := ms.loc
                            if draw
                                brdw.unshift(
                                     drawms.new(
                                           time[historyOffset(ms.loc)]
                                         , time
                                         , low [historyOffset(ms.loc)]
                                         , "BOS"
                                         , dncss
                                         , line.style_dashed
                                          )
                                         )

                    if not na(ms.bos) and draw
                        dw        = brdw.get(0)
                        dw.x2    := time

                    if draw
                        choch     = bldw.get(0)
                        choch.x2 := time

                    switch
                        low <= ms.bos and close >= ms.bos and not na(ms.bos) and buildsweep =>

                            ms.dnsweep   := true
                            ms.bos       := low
                            if draw
                                dw        = brdw.get(0)
                                dw.x2    := time
                                dw.style := line.style_dotted
                                dw.txt   := "x"
                                brdw.unshift(
                                     drawms.new(
                                           time
                                         , time
                                         , low
                                         , "BOS"
                                         , dncss
                                         , line.style_dashed
                                          )
                                         )


                            ms.xloc      := bar_index

                        close <= ms.bos and not na(ms.bos) =>

                            ms.txt       := "bos"
                            ms.zz        := ms.bos
                            ms.zn        := bar_index
                            brob.fnOB(false, btmP, idbear, sourceBearRvol)
                            id        = ms.find(true, false, false)
                            ms.xloc  := bar_index
                            ms.bos   := na
                            ms.choch := high     [id]
                            ms.loc   := bar_index[id]
                            if draw
                                dw        = brdw.get(0)
                                dw.x2    := time
                                dw.style := internal ? line.style_dashed : line.style_solid
                                choch     = bldw.get(0)
                                choch.x1 := time [id]
                                choch.x2 := time
                                choch.y  := high [id]


                    switch
                        high >= ms.choch and close <= ms.choch and buildsweep =>

                            ms.upsweep   := true
                            ms.choch     := high
                            ms.xloc      := bar_index
                            if draw
                                dw        = bldw.get(0)
                                dw.x2    := time
                                dw.style := line.style_dotted
                                dw.txt   := "x"
                                bldw.unshift(
                                     drawms.new(
                                           time
                                         , time
                                         , high
                                         , "CHoCH"
                                         , upcss
                                         , line.style_dashed
                                          )
                                         )


                        close >= ms.choch =>

                            ms.txt       := "choch"
                            ms.zz        := ms.choch
                            ms.zn        := bar_index
                            blob.fnOB(true, topP, idbull, sourceBullRvol)
                            id        = ms.find(false, false, false)
                            switch
                                na(ms.bos) =>
                                    ms.choch := low[id]
                                    if draw
                                        brdw.unshift(
                                             drawms.new(
                                                  time
                                                 , time
                                                 , low
                                                 , "BOS"
                                                 , dncss
                                                 , line.style_dashed
                                                 )
                                                 )
                                        choch = brdw.get(0)
                                        choch.x1 := time[historyOffset(ms.temp)]
                                => ms.choch := ms.bos//low[id + 1] < low[id] ? low[id + 1] : low[id]
                            ms.bos   := na
                            ms.main  := high
                            ms.trend := 1
                            ms.loc   := bar_index
                            ms.xloc  := bar_index
                            ms.temp  := ms.loc
                            if draw
                                dw         = bldw.get(0)
                                dw.x2     := time
                                dw.txt    := "CHoCH"
                                dw.style  := internal ? line.style_dashed : line.style_solid
                                choch      = brdw.get(0)
                                choch.x2  := time
                                choch.y   := ms.choch
                                choch.txt := "CHoCH"


                            ms.xloc       := bar_index


                1 =>
                    if high >= ms.main
                        ms.main     := high
                        ms.temp     := bar_index

                    if na(ms.bos)
                        if crossdn and close < open and close[1] < open[1]
                            ms.bos  := ms.main
                            ms.loc  := ms.temp
                            ms.xloc := ms.loc
                            if draw
                                bldw.unshift(
                                     drawms.new(
                                           time[historyOffset(ms.loc)]
                                         , time
                                         , high[historyOffset(ms.loc)]
                                         , "BOS"
                                         , upcss
                                         , line.style_dashed
                                          )
                                         )

                    if bar_index % mslen * 2 == 0
                        if not na(ms.bos) and msmode == "Adjusted Points" and plp.size() > 0
                            if plp.get(0) > ms.choch
                                // ms.xloc  := pln.get(0)
                                ms.choch := plp.get(0)
                                ms.loc   := pln.get(0)
                                ms.xloc  := pln.get(0)
                                ms.temp  := pln.get(0)
                                // ms.loc   := pln.get(0)
                                if draw
                                    choch     = brdw.get(0)
                                    choch.x1 := time [historyOffset(pln.get(0))]
                                    choch.x2 := time
                                    choch.y  := plp.get(0)

                    if not na(ms.bos) and draw
                        dw         = bldw.get(0)
                        dw.x2     := time

                    if draw
                        choch      = brdw.get(0)
                        choch.x2  := time

                    switch
                        high >= ms.bos and close <= ms.bos and not na(ms.bos) and buildsweep =>

                            ms.upsweep   := true
                            ms.bos       := high
                            if draw
                                dw        = bldw.get(0)
                                dw.x2    := time
                                dw.style := line.style_dotted
                                dw.txt   := "x"
                                bldw.unshift(
                                     drawms.new(
                                           time
                                         , time
                                         , high
                                         , "BOS"
                                         , upcss
                                         , line.style_dashed
                                          )
                                         )


                            ms.xloc      := bar_index


                        close >= ms.bos and not na(ms.bos) =>

                            ms.txt       := "bos"
                            ms.zz        := ms.bos
                            ms.zn        := bar_index
                            blob.fnOB(true, topP, idbull, sourceBullRvol)
                            id        = ms.find(false, false, false)
                            ms.xloc  := bar_index
                            ms.bos   := na
                            ms.choch := low      [id]
                            ms.loc   := bar_index[id]
                            if draw
                                dw        = bldw.get(0)
                                dw.x2    := time
                                dw.style := internal ? line.style_dashed : line.style_solid
                                choch     = brdw.get(0)
                                choch.x1 := time [id]
                                choch.x2 := time
                                choch.y  := low  [id]


                    switch
                        low  <= ms.choch and close >= ms.choch and buildsweep =>

                            ms.dnsweep   := true
                            ms.choch     := low
                            ms.xloc      := bar_index
                            if draw
                                dw        = brdw.get(0)
                                dw.x2    := time
                                dw.style := line.style_dotted
                                dw.txt   := "x"
                                brdw.unshift(
                                     drawms.new(
                                           time
                                         , time
                                         , low
                                         , "CHoCH"
                                         , dncss
                                         , line.style_dashed
                                          )
                                         )


                        close <= ms.choch =>

                            ms.txt       := "choch"
                            ms.zz        := ms.choch
                            ms.zn        := bar_index
                            brob.fnOB(false, btmP, idbear, sourceBearRvol)
                            id        = ms.find(true, false, false)
                            switch
                                na(ms.bos) =>
                                    ms.choch := high[id]
                                    if draw
                                        bldw.unshift(
                                             drawms.new(
                                                   time
                                                 , time
                                                 , high
                                                 , "BOS"
                                                 , upcss
                                                 , line.style_dashed
                                                 )
                                                 )
                                        choch = bldw.get(0)
                                        choch.x1 := time[historyOffset(ms.temp)]
                                => ms.choch := ms.bos//high[id + 1] > high[id] ? high[id + 1] : high[id]
                            ms.bos   := na
                            ms.main  := low
                            ms.trend := -1
                            ms.loc   := bar_index
                            ms.temp  := ms.loc
                            if draw
                                dw         = brdw.get(0)
                                dw.x2     := time
                                dw.txt    := "CHoCH"
                                dw.style  := internal ? line.style_dashed : line.style_solid
                                choch      = bldw.get(0)
                                choch.y   := ms.choch
                                choch.x2  := time
                                choch.txt := "CHoCH"


                            ms.xloc       := bar_index


    if barstate.isconfirmed
        blob.mitigated()
        brob.mitigated()
        bool newBlock = (blob.size() > 0 and blob.get(0).loc == time) or (brob.size() > 0 and brob.get(0).loc == time)
        if overlap and newBlock
            overlap(blob, brob)
        while bldw.size() > limit
            bldw.pop()
        while brdw.size() > limit
            brdw.pop()

    if obshow and oblast > 0
        if barstate.islast
            if blob.size() > 0
                for i = 0 to math.min(oblast - 1, blob.size() - 1)
                    obs = blob.get(i)
                    display(obs, blob, i)

            if brob.size() > 0
                for i = 0 to math.min(oblast - 1, brob.size() - 1)
                    obs = brob.get(i)
                    display(obs, brob, i)

    if barstate.islast and draw and bldw.size() > 0 and brdw.size() > 0
        for i = 0 to bldw.size() - 1
            obj = bldw.get(i)
            if i < limit and (not windowsis or obj.x2 >= time[math.min(bar_index, mswindow)])
                bin.ln.unshift(
                     line.new(
                           x1    = obj.x1
                         , x2    = obj.x2
                         , y1    = obj.y
                         , y2    = obj.y
                         , color = obj.css
                         , style = obj.style
                         , xloc  = xloc.bar_time
                          )
                         )
                bin.lb.unshift(
                     label.new(
                           x         = int(math.avg(bin.ln.get(0).get_x1(), bin.ln.get(0).get_x2()))
                         , y         = obj.y
                         , xloc      = xloc.bar_time
                         , color     = #ffffff00
                         , style     = label.style_label_down
                         , textcolor = obj.css
                         , size      = mstext.txSz()
                         , text      = obj.txt
                          )
                         )

                if msbubble
                    bin.lb.unshift(
                         label.new(
                               x     = obj.x1
                             , y     = obj.y
                             , xloc  = xloc.bar_time
                             , color = color.new(obj.css, 80)
                             , style = label.style_circle
                             , size  = size.tiny
                              )
                             )

        for i = 0 to brdw.size() - 1
            obj = brdw.get(i)
            if i < limit and (not windowsis or obj.x2 >= time[math.min(bar_index, mswindow)])
                bin.ln.unshift(
                     line.new(
                           x1    = obj.x1
                         , x2    = obj.x2
                         , y1    = obj.y
                         , y2    = obj.y
                         , color = obj.css
                         , style = obj.style
                         , xloc  = xloc.bar_time
                          )
                         )
                bin.lb.unshift(
                     label.new(
                           x         = int(math.avg(bin.ln.get(0).get_x1(), bin.ln.get(0).get_x2()))
                         , y         = obj.y
                         , xloc      = xloc.bar_time
                         , color     = #ffffff00
                         , style     = label.style_label_up
                         , textcolor = obj.css
                         , size      = mstext.txSz()
                         , text      = obj.txt
                          )
                         )

                if msbubble
                    bin.lb.unshift(
                             label.new(
                                   x     = obj.x1
                                 , y     = obj.y
                                 , xloc  = xloc.bar_time
                                 , color = color.new(obj.css, 80)
                                 , style = label.style_circle
                                 , size  = size.tiny
                                  )
                                 )

    [ms, blob, brob]

//}
// Section

// Always call stateful calculations so their history remains consistent.
[ms, bullOBs, bearOBs] = structure(swingcssup, swingcssdn, showSwing, false, swingLimit)

var color css = na

method darkcss(color css, float factor) =>

    blue  = color.b(css) * (1 - factor)
    red   = color.r(css) * (1 - factor)
    green = color.g(css) * (1 - factor)

    color.rgb(red, green, blue, 0)

if not na(ms) and barstate.isconfirmed and (not windowsis or bar_index > last_bar_index - mswindow)
    css := ms.trend == 1 ? swingcssup : swingcssdn
    css := (ms.txt == "bos" ? css : css.darkcss(0.3))


barcolor(candlecss ? css : na)

// Calculation and signal state remain independent of drawing toggles.
[bullGaps, bearGaps, bullRaidBar, bearRaidBar] = dFVG()
int mappingTrend = mapping(showMapping)
var int bullSweepBar = na
var int bearSweepBar = na
if barstate.isconfirmed
    if ms.dnsweep
        bullSweepBar := bar_index
    if ms.upsweep
        bearSweepBar := bar_index

bool bullSweepOK = recentEvent(bullSweepBar, bar_index, signalSweepBars) or recentEvent(bullRaidBar, bar_index, signalSweepBars)
bool bearSweepOK = recentEvent(bearSweepBar, bar_index, signalSweepBars) or recentEvent(bearRaidBar, bar_index, signalSweepBars)
float confirmationRvol = relativeVolume(volume, signalVolumeBase)
int bullCandidate = signalCandidate(bullOBs, bullGaps, 1, ms.trend, mappingTrend, bullSweepOK, confirmationRvol)
int bearCandidate = signalCandidate(bearOBs, bearGaps, -1, ms.trend, mappingTrend, bearSweepOK, confirmationRvol)
[buyArrow, sellArrow] = resolveSignals(barstate.isconfirmed, bullCandidate, bearCandidate)
var int buyCount = 0
var int sellCount = 0
var string lastSignal = "Chưa có"
var string waitReason = "Chờ nến đóng"
if barstate.isconfirmed
    int direction = ms.trend == 1 ? 1 : -1
    zones = direction == 1 ? bullOBs : bearOBs
    gaps = direction == 1 ? bullGaps : bearGaps
    [best, available] = signalProgress(zones, gaps, direction, mappingTrend, direction == 1 ? bullSweepOK : bearSweepOK, confirmationRvol)
    [unused, enabled, ignored] = signalEvidence(direction, mappingTrend, false, false, confirmationRvol, na)
    int required = signalMode == "Strict" ? enabled : math.min(signalMinEvidence, enabled)
    waitReason := ms.trend == 0 ? "Chờ cấu trúc" : best < 0 ? "Chờ nến từ chối OB" : not available ? "Thiếu dữ liệu volume" : "Đồng thuận " + str.tostring(best) + "/" + str.tostring(enabled) + " | cần " + str.tostring(required)
    if buyArrow or sellArrow
        buyCount += buyArrow ? 1 : 0
        sellCount += sellArrow ? 1 : 0
        lastSignal := (buyArrow ? "BUY " : "SELL ") + str.format_time(time_close, "dd/MM HH:mm", syminfo.timezone)

var table signalPanel = table.new(position.top_right, 1, 4, bgcolor = color.new(color.black, 15))
if barstate.islast
    if showSignalStatus
        table.cell(signalPanel, 0, 0, "SMC 1.3.0 | " + signalMode, text_color = color.white)
        table.cell(signalPanel, 0, 1, "Lịch sử đã tính: BUY " + str.tostring(buyCount) + " | SELL " + str.tostring(sellCount), text_color = color.white)
        table.cell(signalPanel, 0, 2, "Gần nhất (giờ sàn): " + lastSignal, text_color = color.white)
        table.cell(signalPanel, 0, 3, waitReason, text_color = color.yellow)
    else
        table.clear(signalPanel, 0, 0, 0, 3)
if buyArrow
    chosen = bullOBs.get(bullCandidate)
    chosen.signaled := true
if sellArrow
    chosen = bearOBs.get(bearCandidate)
    chosen.signaled := true

plotshape(showSignals and buyArrow, title = "Confirmed bullish opportunity", style = shape.arrowup, location = location.belowbar, color = #089981, text = "BUY", textcolor = #089981, size = size.normal)
plotshape(showSignals and sellArrow, title = "Confirmed bearish opportunity", style = shape.arrowdown, location = location.abovebar, color = #f23645, text = "SELL", textcolor = #f23645, size = size.normal)

alertcondition(buyArrow, "Confirmed BUY", "Confirmed BUY: {{ticker}} {{interval}} at {{close}}")
alertcondition(sellArrow, "Confirmed SELL", "Confirmed SELL: {{ticker}} {{interval}} at {{close}}")
